<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="OctagonMission">
  <BehaviorTree ID="OctagonMission">
    <Sequence name="octagon_mission">
      <PosSetpoint z="1.5"/>
      <Fallback name="octagon_search_heading">
        <Sequence name="pool_a_or_d_octagon_search">
          <PoolAOrD/>
          <AttSetpoint yaw="0.61086524"/>
        </Sequence>
        <AttSetpoint yaw="-0.61086524"/>
      </Fallback>
      <SearchDhdFront/>
      <ApproachDhdFront/>
      <PosSetpoint z="0.5"/>
      <PosSetpoint x="1.0" velocity="true"/>
      <FindDhdDown/>
      <AlignOverDhd/>
      <SurfaceForOctagonPoints/>
      <Sequence name="grab_and_drop_objects">
        <GrabYellowObject/>
        <DropYellowObject/>
        <GrabRedObject/>
        <DropRedObject/>
      </Sequence>
      <ReturnToDhdCenter/>
      <SurfaceAtOctagon/>
      <PosSetpoint z="0.0"/>
    </Sequence>
  </BehaviorTree>
</root>
