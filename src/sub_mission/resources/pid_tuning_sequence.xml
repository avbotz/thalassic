<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="PidTuningMission">
  <BehaviorTree ID="PidTuningMission">
    <Sequence name="pid_tuning_mission">
      <PosSetpoint z="1.0"/>
      <Repeat num_cycles="-1">
        <Sequence name="pid_tuning_loop">
          <NotKilled/>

          <PosSetpoint x="2.0" y="0.0" z="0.0"/>
          <Sleep msec="8000"/>

          <PosSetpoint x="2.0" y="2.0" z="0.0"/>
          <Sleep msec="8000"/>

          <PosSetpoint x="2.0" y="2.0" z="1.0"/>
          <Sleep msec="8000"/>

          <AttSetpoint yaw="3.14159265"/>
          <AttSetpoint yaw="1.57079633"/>
          <AttSetpoint yaw="0.0"/>
          <AttSetpoint yaw="-3.14159265"/>
          <AttSetpoint yaw="-1.57079633"/>
          <AttSetpoint yaw="0.0"/>
          <Sleep msec="8000"/>

          <Spin yaw="12.56637061"/>

          <PosSetpoint z="1.0"/>

          <PosSetpoint x="0.0" y="0.0" z="0.0"/>
          <AttSetpoint yaw="0.0"/>
          <Sleep msec="8000"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>
