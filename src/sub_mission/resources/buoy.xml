<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BuoyMission">
  <BehaviorTree ID="BuoyMission">
    <Fallback name="buoy_mission">
      <Sequence name="buoy_found_path">
        <FindPathMarkerForBuoy/>
        <PosSetpoint x="1.0" velocity="true"/>
        <SearchForBuoy/>
        <ApproachBuoy/>
        <Sequence name="circle_buoy_control_only">
          <PosSetpoint y="-1.5" velocity="true"/>
          <PosSetpoint x="3.0" velocity="true"/>
          <AttSetpoint yaw="1.57079633"/>
          <PosSetpoint x="3.0" velocity="true"/>
          <AttSetpoint yaw="3.14159265"/>
          <PosSetpoint x="3.0" velocity="true"/>
          <AttSetpoint yaw="-1.57079633"/>
        </Sequence>
        <ReturnToBuoyStart/>
        <PosSetpoint y="-1.5" velocity="true"/>
        <PosSetpoint z="1.0"/>
        <Fallback name="continue_heading">
          <Sequence name="pool_a_or_d_continue">
            <PoolAOrD/>
            <AttSetpoint yaw="-0.34906585"/>
            <PosSetpoint x="1.5" velocity="true"/>
          </Sequence>
          <Sequence name="pool_b_or_c_continue">
            <Inverter>
              <PoolAOrD/>
            </Inverter>
            <AttSetpoint yaw="0.34906585"/>
            <PosSetpoint x="1.5" velocity="true"/>
          </Sequence>
          <Sequence name="default_continue">
            <AttSetpoint yaw="0.34906585"/>
            <PosSetpoint x="1.5" velocity="true"/>
          </Sequence>
        </Fallback>
      </Sequence>
      <Sequence name="missing_buoy_recovery">
        <RecoverFromMissingBuoy/>
        <PosSetpoint z="1.0"/>
        <PosSetpoint x="10.0" velocity="true"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
