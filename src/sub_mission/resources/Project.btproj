<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="missions/pid_tuning.xml"/>
    <include path="missions/pool_a.xml"/>
    <include path="missions/pool_b.xml"/>
    <include path="missions/pool_c.xml"/>
    <include path="missions/pool_d.xml"/>
    <include path="missions/pool_test.xml"/>
    <include path="missions/prelim.xml"/>
    <include path="missions/hard_coded_torp.xml"/>
    <include path="missions/hard_coded_octagon.xml"/>
    <include path="missions/hard_coded_competition.xml"/>
    <include path="missions/slalom_perception_hold_test.xml"/>
    <include path="missions/slalom_three_test.xml"/>
    <include path="missions/vision_test.xml"/>
    <include path="trees/bins.xml"/>
    <include path="trees/coin_flip.xml"/>
    <include path="trees/competition.xml"/>
    <include path="trees/gate.xml"/>
    <include path="trees/hard_coded_gate.xml"/>
    <include path="trees/hard_coded_slalom.xml"/>
    <include path="trees/hard_coded_competition.xml"/>
    <include path="trees/hard_coded_torp.xml"/>
    <include path="trees/hard_coded_octagon.xml"/>
    <include path="trees/octagon.xml"/>
    <include path="trees/pool_test.xml"/>
    <include path="trees/prelim.xml"/>
    <include path="trees/slalom.xml"/>
    <include path="trees/torp.xml"/>
    <include path="trees/vision_test.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="AddAttSetpoint">
            <input_port name="roll" default="nan">Roll offset in radians</input_port>
            <input_port name="pitch" default="nan">Pitch offset in radians</input_port>
            <input_port name="yaw" default="nan">Yaw offset in radians</input_port>
        </Action>
        <Action ID="AverageAngles">
            <input_port name="a">First angle in radians</input_port>
            <input_port name="b">Second angle in radians</input_port>
            <output_port name="out">Circular mean of a and b in radians</output_port>
        </Action>
        <Action ID="AlignToDetection">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task's model</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="yaw" default="true">Steer yaw to zero the horizontal bearing</input_port>
            <input_port name="depth" default="false">Steer depth to zero the vertical bearing</input_port>
            <input_port name="tolerance" default="0.05">Aligned when |bearing| &lt;= tolerance (rad)</input_port>
            <input_port name="depth_gain" default="1.5">Meters of depth change per radian of bearing</input_port>
            <input_port name="max_depth_step" default="0.5">Depth correction clamp per frame (m)</input_port>
            <input_port name="timeout_msec" default="30000">Maximum align time before FAILURE</input_port>
        </Action>
        <Action ID="AngularVelocitySetpoint">
            <input_port name="roll" default="0.0">Roll rate in radians per second</input_port>
            <input_port name="pitch" default="0.0">Pitch rate in radians per second</input_port>
            <input_port name="yaw" default="0.0">Yaw rate in radians per second</input_port>
        </Action>
        <Action ID="AttSetpoint">
            <input_port name="roll" default="nan">Roll setpoint in radians</input_port>
            <input_port name="pitch" default="nan">Pitch setpoint in radians</input_port>
            <input_port name="yaw" default="nan">Yaw setpoint in radians</input_port>
        </Action>
        <Condition ID="DetectionVisible">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task's model</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="max_age_msec" default="1000">How recent the detection must be</input_port>
        </Condition>
        <Action ID="DownContinuousAlign">
            <input_port name="task">Only accept down-camera detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="tolerance" default="0.35">Centered when both bearings are within tolerance (rad)</input_port>
            <input_port name="desired_distance" default="nan">Optional camera-to-object distance to hold in meters</input_port>
            <input_port name="distance_tolerance" default="0.5">Distance error allowed at completion (m)</input_port>
            <input_port name="default_distance" default="1.0">Distance used when detection distance is unavailable</input_port>
            <input_port name="center_gain" default="1.0">Scale factor for down-camera x/y centering offsets</input_port>
            <input_port name="orient" default="true">Yaw to detection orientation metadata when present</input_port>
            <input_port name="require_orientation" default="false">Fail on timeout instead of accepting center-only alignment when orientation is absent</input_port>
            <input_port name="orientation_settle_frames" default="3">Consecutive consistent orientation frames required before yawing</input_port>
            <input_port name="orientation_consistency_deg" default="10.0">Maximum frame-to-frame axial-angle change accepted as consistent</input_port>
            <input_port name="orient_tolerance_deg" default="5.0">Orientation error allowed at completion</input_port>
            <input_port name="min_msec" default="3000">Minimum closed-loop alignment time</input_port>
            <input_port name="timeout_msec" default="30000">Maximum align time before FAILURE</input_port>
            <input_port name="update_msec" default="200">Minimum time between movement corrections</input_port>
        </Action>
        <Action ID="DownForwardAlign">
            <input_port name="task">Only accept down-camera detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="max_dist" default="10.0">Maximum forward travel before SUCCESS</input_port>
            <input_port name="forward_step" default="1.0">Forward target extension per update in meters</input_port>
            <input_port name="default_distance" default="1.0">Distance used when detection distance is unavailable</input_port>
            <input_port name="center_gain" default="1.0">Scale factor for down-camera x/y centering offsets</input_port>
            <input_port name="orient" default="false">Follow detection orientation metadata</input_port>
            <input_port name="lateral_sweep_step" default="1.0">Right/left search step when no detection is visible</input_port>
            <input_port name="stop_camera">Succeed when this camera sees the stop target</input_port>
            <input_port name="stop_task">Succeed when this task is detected (empty disables)</input_port>
            <input_port name="stop_class_id">Only accept this stop-target class id</input_port>
            <input_port name="stop_min_score" default="0.0">Minimum stop-target detection confidence</input_port>
            <input_port name="update_msec" default="300">Minimum time between movement corrections</input_port>
            <input_port name="timeout_msec" default="30000">Maximum align time before SUCCESS</input_port>
        </Action>
        <Action ID="DownForwardSweepAlign">
            <input_port name="task">Only accept detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="max_dist" default="10.0">Maximum forward travel before SUCCESS</input_port>
            <input_port name="forward_step" default="1.0">Forward target extension per update in meters</input_port>
            <input_port name="default_distance" default="1.0">Distance used when detection distance is unavailable</input_port>
            <input_port name="center_gain" default="1.0">Scale factor for down-camera x/y centering offsets</input_port>
            <input_port name="orient" default="false">Follow detection orientation metadata</input_port>
            <input_port name="lateral_sweep_step" default="1.0">Right/left search step when no down-camera detection is visible</input_port>
            <input_port name="stop_camera">Succeed when this camera sees the stop target</input_port>
            <input_port name="stop_task">Succeed when this task is detected (empty disables)</input_port>
            <input_port name="stop_class_id">Only accept this stop-target class id</input_port>
            <input_port name="stop_min_score" default="0.0">Minimum stop-target detection confidence</input_port>
            <input_port name="update_msec" default="300">Minimum time between movement corrections</input_port>
            <input_port name="timeout_msec" default="30000">Maximum scan time before FAILURE</input_port>
        </Action>
        <Action ID="DownSweepAlign">
            <input_port name="task">Only accept down-camera detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="lateral_step" default="1.0">Distance from the start point to each side (m)</input_port>
            <input_port name="num_sweeps" default="3">Complete right-to-left passes before FAILURE</input_port>
            <input_port name="sample_timeout_msec" default="1000">Detection sample time at each side</input_port>
            <input_port name="move_timeout_msec" default="20000">Maximum wait for each lateral movement</input_port>
        </Action>
        <Action ID="DownPatternScan">
            <input_port name="task">Task model to search for with the down camera</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="movement_dist" default="1.65">Search-pattern movement distance in meters</input_port>
            <input_port name="sample_timeout_msec" default="2500">Maximum detection sample time at each point</input_port>
            <input_port name="move_timeout_msec" default="20000">Maximum wait for each pattern move</input_port>
        </Action>
        <Action ID="DropBalls">
            <input_port name="dropper_id" default="0">Dropper id to command</input_port>
            <input_port name="open" default="true">Dropper state to command</input_port>
            <input_port name="timeout_msec" default="5000">Maximum wait for set_dropper response</input_port>
        </Action>
        <Action ID="ForwardContinuousAlign">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="max_dist" default="10.0">Maximum forward travel before SUCCESS</input_port>
            <input_port name="forward_velocity" default="1.0">Fixed body-forward velocity in meters per second</input_port>
            <input_port name="close_distance" default="3.0">Distance that completes the approach</input_port>
            <input_port name="detection_loss_msec" default="3000">Target-loss time that completes the approach</input_port>
            <input_port name="timeout_msec" default="30000">Maximum align time before SUCCESS</input_port>
            <input_port name="confirmation_frames" default="1">Matching frames required before propulsion</input_port>
            <input_port name="continue_on_loss" default="true">Continue on the last heading after target loss</input_port>
            <input_port name="stop_on_close" default="true">Stop immediately when the target is close</input_port>
            <input_port name="loss_is_success" default="false">Accept target loss only after a confirmed close pass</input_port>
            <input_port name="loss_min_travel" default="0.0">Minimum odom travel before a post-close loss can succeed</input_port>
            <input_port name="timeout_is_success" default="true">Treat bounded timeout as SUCCESS</input_port>
            <input_port name="max_dist_is_success" default="true">Treat maximum travel as SUCCESS</input_port>
            <input_port name="max_yaw_step_deg" default="45.0">Maximum heading correction per frame</input_port>
            <input_port name="fixed_distance_from_detection" default="false">Lock transit distance from confirmed vision range</input_port>
            <input_port name="pass_distance" default="0.0">Meters to continue beyond detected gap plane</input_port>
            <input_port name="min_transit_distance" default="0.0">Minimum safe fixed transit distance</input_port>
        </Action>
        <Action ID="ForwardFixedTransit">
            <input_port name="vision_distance_m">Range along the just-confirmed pole-clearance path</input_port>
            <input_port name="pass_distance" default="0.0">Distance to continue past the gap plane</input_port>
            <input_port name="min_transit_distance" default="0.0">Minimum safe transit distance</input_port>
            <input_port name="completion_tolerance_m" default="0.15">Odometry shortfall accepted within pass margin</input_port>
            <input_port name="max_dist" default="10.0">Hard transit distance safety limit</input_port>
            <input_port name="forward_velocity" default="0.3">Forward velocity</input_port>
            <input_port name="timeout_msec" default="30000">Transit timeout</input_port>
            <input_port name="min_progress_m" default="0.10">Minimum odometry advance that proves motion</input_port>
            <input_port name="progress_timeout_msec" default="4000">Maximum time without sufficient progress</input_port>
        </Action>
        <Action ID="ForwardSweepAlign">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="attempts" default="4">Detection frames sampled at each yaw</input_port>
            <input_port name="num_sweeps" default="3">Forward sweep passes before FAILURE</input_port>
            <input_port name="forward_step" default="2.0">Forward move between sweeps in meters</input_port>
            <input_port name="sample_timeout_msec" default="2500.0">Maximum detection sample time per yaw</input_port>
            <input_port name="move_timeout_msec" default="20000">Maximum wait for each commanded movement</input_port>
        </Action>
        <Action ID="StationarySweepAlign">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="attempts" default="3">Stable matching frames required for an acquisition</input_port>
            <input_port name="num_sweeps" default="1">Complete stationary left/right sweeps before acquisition</input_port>
            <input_port name="required_pole_count" default="1">Exactly one selected pole is required</input_port>
            <input_port name="max_left_offset_deg" default="45">Largest safe port-side scan offset before using the least-oblique pole</input_port>
            <input_port name="sample_timeout_msec" default="1800.0">Maximum detection sampling time at each heading</input_port>
            <input_port name="move_timeout_msec" default="20000">Maximum wait for each in-place yaw command</input_port>
            <output_port name="transit_distance_m">Vision range to the selected pole's right-clearance path</output_port>
        </Action>
        <Action ID="LoadModel">
            <input_port name="camera" default="front">Camera whose vision node loads the model</input_port>
            <input_port name="task">Task model to load, e.g. gate</input_port>
            <input_port name="timeout_msec" default="20000">Maximum wait for service + load</input_port>
        </Action>
        <Action ID="ResetStateOnRevive">
            <input_port name="timeout_msec" default="5000">Maximum wait for control reset response</input_port>
        </Action>
        <Action ID="LateralAlignToDetection">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task's model</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="use_board_aim_bearing" default="false">Use calibrated fixed-hole bearings published with a board detection</input_port>
            <input_port name="lock_board_aim" default="false">Lock three consistent aim rays into an odom-frame lateral/depth target</input_port>
            <input_port name="target_distance" default="1.15">Camera-to-target plane distance used to project pixel bearings</input_port>
            <input_port name="target_offset_right_m" default="0.0">Fixed target offset to camera-right from the detected item, in meters</input_port>
            <input_port name="target_offset_down_m" default="0.0">Fixed target offset downward from the detected item, in meters</input_port>
            <input_port name="tolerance" default="0.012">Centered when horizontal and vertical bearing are within this radian bound</input_port>
            <input_port name="max_lateral_step" default="0.10">Maximum body-lateral correction per update in meters</input_port>
            <input_port name="max_depth_step" default="0.08">Maximum vertical correction per update in meters</input_port>
            <input_port name="settle_frames" default="8">Consecutive centered model detections required before SUCCESS</input_port>
            <input_port name="min_msec" default="1500">Minimum closed-loop alignment time</input_port>
            <input_port name="timeout_msec" default="15000">Maximum alignment time before FAILURE</input_port>
            <input_port name="update_msec" default="300">Minimum time between translation corrections</input_port>
        </Action>
        <Action ID="MoveRelative">
            <input_port name="x" default="0.0">Forward offset in meters</input_port>
            <input_port name="y" default="0.0">Right offset in meters</input_port>
            <input_port name="z" default="0.0">Vertical offset in meters; negative is down</input_port>
        </Action>
        <Action ID="MoveRelativePos">
            <input_port name="x" default="0.0">Global east offset in meters</input_port>
            <input_port name="y" default="0.0">Global north offset in meters</input_port>
            <input_port name="z" default="0.0">Global vertical offset in meters; negative is down</input_port>
        </Action>
        <Action ID="NavigateToTransform">
            <input_port name="source_frame">Frame whose current position is the aim point</input_port>
            <input_port name="target_frame">Attached frame to move into the source position</input_port>
            <input_port name="horizontal_only" default="false">Preserve depth while aligning the attached frame</input_port>
            <input_port name="fallback_forward">Body-forward offset used when TF is unavailable</input_port>
            <input_port name="fallback_right">Body-right offset used when TF is unavailable</input_port>
            <input_port name="fallback_up">Body-up offset used when TF is unavailable</input_port>
            <input_port name="timeout_msec" default="30000">Maximum TF lookup and movement time before FAILURE</input_port>
        </Action>
        <Action ID="OctagonSurfaceSweep">
            <input_port name="task">Front-camera model task to inspect</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="yaw_step_deg" default="30.0">Yaw increment while searching for class 0</input_port>
            <input_port name="diversion_deg" default="90.0">One-time yaw increment after seeing class 2</input_port>
            <input_port name="surface_z" default="-0.3">Final ENU z setpoint after seeing class 0</input_port>
            <input_port name="move_timeout_msec" default="20000">Maximum wait for each yaw or depth command</input_port>
        </Action>
        <Condition ID="NotKilled"/>
        <Condition ID="SearchRole">Succeeds when the launch-time role is SEARCH</Condition>
        <Condition ID="SurveyRole">Succeeds when the launch-time role is SURVEY</Condition>
        <Condition ID="TorpBoardV1">Succeeds when launch-time torp_board_type is v1</Condition>
        <Action ID="OrientToDetectionAtDist">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task's model</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="desired_distance" default="2.0">Distance to hold from the target in meters</input_port>
            <input_port name="max_detection_distance" default="0.0">Reject pose observations beyond this range; zero disables the bound</input_port>
            <input_port name="tolerance" default="0.35">Centered when |horizontal bearing| &lt;= tolerance (rad)</input_port>
            <input_port name="distance_tolerance" default="0.5">Distance error allowed at completion (m)</input_port>
            <input_port name="orient_tolerance_deg" default="5.0">Orientation error allowed at completion</input_port>
            <input_port name="max_position_step" default="0.5">Maximum translation correction per update (m)</input_port>
            <input_port name="use_aim_bearing" default="false">Use calibrated aim_bearing_horizontal metadata when available</input_port>
            <input_port name="require_heading" default="false">Fail when no calibrated board-normal heading is available</input_port>
            <input_port name="settle_frames" default="1">Consecutive in-tolerance detection frames required before SUCCESS</input_port>
            <input_port name="min_msec" default="6500">Minimum closed-loop alignment time</input_port>
            <input_port name="timeout_msec" default="30000">Maximum align time before FAILURE</input_port>
            <input_port name="update_msec" default="300">Minimum time between movement corrections</input_port>
        </Action>
        <Action ID="PosSetpoint">
            <input_port name="x" default="nan">North/forward position setpoint</input_port>
            <input_port name="y" default="nan">East/right position setpoint</input_port>
            <input_port name="z" default="nan">Vertical position setpoint; negative is down</input_port>
        </Action>
        <Action ID="SaveGateHome">
            <output_port name="x">Saved gate-home x coordinate</output_port>
            <output_port name="y">Saved gate-home y coordinate</output_port>
        </Action>
        <Action ID="ShootTorpedo">
            <input_port name="torpedo_id">Torpedo id to command</input_port>
            <input_port name="open" default="true">Torpedo thruster state to command</input_port>
            <input_port name="timeout_msec" default="5000">Maximum wait for launch_torpedo response</input_port>
        </Action>
        <Action ID="Spin">
            <input_port name="yaw" default="12.56637061">Yaw distance to spin in radians (positive = CCW)</input_port>
            <input_port name="rate" default="3.14159265">Maximum yaw rate in radians per second</input_port>
        </Action>
        <Action ID="SweepCheck">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="attempts" default="4">Detection frames sampled at each yaw</input_port>
            <input_port name="sample_timeout_msec" default="2500.0">Maximum detection sample time per yaw</input_port>
            <input_port name="move_timeout_msec" default="20000">Maximum wait for each yaw move</input_port>
        </Action>
        <Action ID="SweepAngle">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="attempts" default="4">Detection frames sampled at each yaw</input_port>
            <input_port name="sample_timeout_msec" default="2500.0">Maximum detection sample time per yaw</input_port>
            <input_port name="move_timeout_msec" default="20000">Maximum wait for each yaw move</input_port>
            <output_port name="yaw">Absolute mission yaw toward the detected object</output_port>
        </Action>
        <Action ID="VelocitySetpoint">
            <input_port name="x" default="0.0">Forward velocity in meters per second</input_port>
            <input_port name="y" default="0.0">Right velocity in meters per second</input_port>
            <input_port name="z" default="0.0">Up velocity in meters per second</input_port>
        </Action>
        <Action ID="WaitForDetection">
            <input_port name="camera" default="front">Detection source: front or down</input_port>
            <input_port name="task">Only accept detections from this task's model</input_port>
            <input_port name="class_id">Only accept this class id (empty = any)</input_port>
            <input_port name="min_score" default="0.0">Minimum detection confidence</input_port>
            <input_port name="timeout_msec" default="15000">Maximum wait before returning FAILURE</input_port>
        </Action>
        <Action ID="WaitUntilHit">
            <input_port name="axis" default="x">Velocity axis to monitor: x, y, or z</input_port>
            <input_port name="threshold" default="-1.0">Speed ratio threshold; negative selects old defaults</input_port>
            <input_port name="timeout_msec" default="40000">Maximum wait time before returning FAILURE</input_port>
        </Action>
    </TreeNodesModel>
</root>
