<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="GateMission">
  <BehaviorTree ID="AlignWithGate">
    <ForceSuccess>
      <Sequence name="align_with_gate">
        <LoadModel camera="front"
                   task="gate"
                   timeout_msec="20000"/>
        <WaitForDetection camera="front"
                          task="gate"
                          class_id="8"
                          min_score="0.0"
                          timeout_msec="15000"
                          start_timeout_after_first_frame="false"/>
        <AlignToDetection camera="front"
                          task="gate"
                          class_id="8"
                          min_score="0.0"
                          yaw="true"
                          depth="false"
                          tolerance="0.05"
                          depth_gain="1.5"
                          max_depth_step="0.5"
                          timeout_msec="30000"/>
      </Sequence>
    </ForceSuccess>
  </BehaviorTree>

  <BehaviorTree ID="GateMission">
    <Sequence name="gate_mission">
      <SavePose name="gate_home"
                x="{@gate_home_x}"
                y="{@gate_home_y}"
                yaw="{@gate_home_yaw}"/>
      <PosSetpoint name="gate_search_depth"
                   x="nan"
                   y="nan"
                   z="-0.7"
                   timeout_msec="0"/>
      <LoadModel camera="front"
                 task="gate"
                 timeout_msec="120000"/>
      <SearchForDetection camera="front"
                          task="gate"
                          class_id="8"
                          min_score="0.20"
                          x="0.10"
                          y="nan"
                          z="nan"
                          sweep_left_m="0.0"
                          sweep_right_m="0.0"
                          timeout_msec="20000"
                          start_timeout_after_first_frame="true"/>
      <SelectGateRole camera="front"
                      task="gate"
                      class_id="8"
                      min_score="0.20"
                      confirmation_frames="3"
                      timeout_msec="30000"/>
      <SquareUpToGate camera="front"
                      task="gate"
                      class_id="8"
                      min_score="0.20"
                      standoff="2.0"
                      target_offset_left="0.0"
                      look_distance="2.8"
                      min_facing_frames="6"
                      max_slant_deg="60.0"
                      position_tolerance="0.15"
                      yaw_tolerance_deg="3.0"
                      settle_msec="1500"
                      facing_timeout_msec="15000"
                      detection_loss_msec="8000"
                      timeout_msec="60000"
                      update_msec="250"/>
      <PosSetpoint name="gate_crossing_depth"
                   x="nan"
                   y="nan"
                   z="-0.9"
                   timeout_msec="0"/>
      <MoveRelative name="through_the_gate"
                    x="3.0"
                    y="0.0"
                    z="0.0"
                    timeout_msec="0"/>
      <Spin name="style"
            yaw="-12.56637061"
            rate="3.14159265"
            timeout_msec="0"/>
      <AttSetpoint name="pool_exit_heading"
                   roll="nan"
                   pitch="nan"
                   yaw="{@gate_exit_yaw}"
                   timeout_msec="0"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AlignToDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="yaw"
                  default="true">Steer yaw to zero the horizontal bearing</input_port>
      <input_port name="depth"
                  default="false">Steer depth to zero the vertical bearing</input_port>
      <input_port name="tolerance"
                  default="0.05">Aligned when |bearing| &lt;= tolerance (rad)</input_port>
      <input_port name="depth_gain"
                  default="1.5">Meters of depth change per radian of bearing</input_port>
      <input_port name="max_depth_step"
                  default="0.5">Depth correction clamp per frame (m)</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum align time before FAILURE</input_port>
    </Action>
    <Action ID="AttSetpoint">
      <input_port name="roll"
                  default="nan">Roll setpoint in radians</input_port>
      <input_port name="pitch"
                  default="nan">Pitch setpoint in radians</input_port>
      <input_port name="yaw"
                  default="nan">Yaw setpoint in radians (odom, counter-clockwise)</input_port>
      <input_port name="timeout_msec"
                  default="0">Maximum wait before FAILURE; 0 scales it with the size of the move</input_port>
    </Action>
    <Action ID="LoadModel">
      <input_port name="camera"
                  default="front">Camera whose vision node loads the model</input_port>
      <input_port name="task">Task model to load, e.g. gate</input_port>
      <input_port name="timeout_msec"
                  default="20000">Maximum wait for service + load</input_port>
    </Action>
    <Action ID="MoveRelative">
      <input_port name="x"
                  default="0.0">Forward offset in meters</input_port>
      <input_port name="y"
                  default="0.0">Left offset in meters</input_port>
      <input_port name="z"
                  default="0.0">Up offset in meters</input_port>
      <input_port name="timeout_msec"
                  default="0">Maximum wait before FAILURE; 0 scales it with the size of the move</input_port>
    </Action>
    <Action ID="PosSetpoint">
      <input_port name="x"
                  default="nan">Odom x setpoint in meters (forward at the start)</input_port>
      <input_port name="y"
                  default="nan">Odom y setpoint in meters (left at the start)</input_port>
      <input_port name="z"
                  default="nan">Odom z setpoint in meters (up; 1 m deep is -1)</input_port>
      <input_port name="timeout_msec"
                  default="0">Maximum wait before FAILURE; 0 scales it with the size of the move</input_port>
    </Action>
    <Action ID="SavePose">
      <output_port name="x">Odom x in meters</output_port>
      <output_port name="y">Odom y in meters</output_port>
      <output_port name="yaw">Yaw in radians (odom, counter-clockwise)</output_port>
    </Action>
    <Action ID="SearchForDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="x"
                  default="nan">Forward velocity in meters per second</input_port>
      <input_port name="y"
                  default="nan">Left velocity in meters per second</input_port>
      <input_port name="z"
                  default="nan">Up velocity in meters per second</input_port>
      <input_port name="sweep_left_m"
                  default="0.0">Lateral search: distance left before turning back</input_port>
      <input_port name="sweep_right_m"
                  default="0.0">Lateral search: distance right after turning back</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum search time before FAILURE; 0 waits forever</input_port>
      <input_port name="start_timeout_after_first_frame"
                  default="false">Start the timeout with the camera's first frame instead of now</input_port>
    </Action>
    <Action ID="SelectGateRole">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="confirmation_frames"
                  default="3">Frames in a row that must show the same role</input_port>
      <input_port name="timeout_msec"
                  default="20000">Maximum wait before FAILURE</input_port>
    </Action>
    <Action ID="Spin">
      <input_port name="yaw"
                  default="-12.56637061">Yaw distance to spin in radians; positive turns left</input_port>
      <input_port name="rate"
                  default="3.14159265">Yaw rate in radians per second</input_port>
      <input_port name="timeout_msec"
                  default="0">Maximum wait before FAILURE; 0 scales it with the size of the move</input_port>
    </Action>
    <Action ID="SquareUpToGate">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="standoff"
                  default="2.0">Distance in front of the gate to finish at (m)</input_port>
      <input_port name="target_offset_left"
                  default="0.0">Aim this far left of the left panel's center, along the gate (m)</input_port>
      <input_port name="look_distance"
                  default="2.8">Back off to this far while finding the facing, to see both panels (m)</input_port>
      <input_port name="min_facing_frames"
                  default="6">Frames showing both panels before moving</input_port>
      <input_port name="max_slant_deg"
                  default="60.0">Facings turned further than this from the camera are rejected</input_port>
      <input_port name="position_tolerance"
                  default="0.15">Finished within this of the standoff point (m)</input_port>
      <input_port name="yaw_tolerance_deg"
                  default="3.0">Finished within this of square to the gate</input_port>
      <input_port name="settle_msec"
                  default="1500">Time within both tolerances before SUCCESS</input_port>
      <input_port name="facing_timeout_msec"
                  default="15000">Go on with fewer facing frames, or none, after this long</input_port>
      <input_port name="detection_loss_msec"
                  default="8000">FAILURE after this long without a frame of the gate; 0 never</input_port>
      <input_port name="timeout_msec"
                  default="60000">Maximum time before FAILURE</input_port>
      <input_port name="update_msec"
                  default="250">Minimum time between commands</input_port>
    </Action>
    <Action ID="WaitForDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="timeout_msec"
                  default="15000">Maximum wait before returning FAILURE</input_port>
      <input_port name="start_timeout_after_first_frame"
                  default="false">Start the timeout with the camera's first frame instead of now</input_port>
    </Action>
  </TreeNodesModel>

</root>
