<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gate: through the left opening, taking the role its images show. The gate
  post-processor's class 8 is that opening, carrying its role (gate_role), so
  the vehicle passes the same side whichever role the course puts there, and
  SelectGateRole sets the role the later tasks (bins) use.
-->
<root BTCPP_format="4"
      main_tree_to_execute="GateMission">
  <BehaviorTree ID="AlignWithGate">
    <ForceSuccess>
      <Sequence name="align_with_gate">
        <LoadModel camera="front"
                   task="gate"
                   timeout_msec="20000"/>
        <WaitForDetection camera="front"
                          task="gate"
                          class_id="8"
                          min_score="0.0"
                          timeout_msec="15000"/>
        <AlignToDetection camera="front"
                          task="gate"
                          class_id="8"
                          min_score="0.0"
                          yaw="true"
                          depth="false"
                          tolerance="0.05"
                          depth_gain="1.5"
                          max_depth_step="0.5"
                          timeout_msec="30000"/>
      </Sequence>
    </ForceSuccess>
  </BehaviorTree>

  <BehaviorTree ID="GateMission">
    <Sequence name="gate_mission">
      <!-- Return Home drives back here, on the start side of the gate. -->
      <SavePose name="gate_home"
                x="{@gate_home_x}"
                y="{@gate_home_y}"/>
      <!-- At the depth the coin flip left, where the role images are. -->
      <LoadModel camera="front"
                 task="gate"
                 timeout_msec="120000"/>
      <!-- Close in slowly, holding the heading, until the left opening is in
           view; at most 2 m once the camera is up. -->
      <SearchForDetection camera="front"
                          task="gate"
                          class_id="8"
                          min_score="0.20"
                          x="0.10"
                          start_timeout_after_first_frame="true"
                          timeout_msec="20000"/>
      <SelectGateRole camera="front"
                      task="gate"
                      class_id="8"
                      min_score="0.20"
                      confirmation_frames="3"
                      timeout_msec="30000"/>
      <!-- Sideways onto the left opening, keeping the heading. Five rays lock
           one odom target, so later frames cannot drag it further left. The
           aim is 0.15 m right of the opening's center, toward the divider,
           for clearance from the outer pole. -->
      <LateralAlignToDetection camera="front"
                               task="gate"
                               class_id="8"
                               min_score="0.20"
                               target_distance="3.25"
                               use_detection_distance="true"
                               max_projection_distance="3.25"
                               target_offset_left="-0.15"
                               align_depth="false"
                               lock_target="true"
                               lock_frames="5"
                               reset_timeout_on_lock="true"
                               tolerance="0.040"
                               max_bearing_jump_rad="0.25"
                               bearing_filter_alpha="0.35"
                               settle_frames="2"
                               min_msec="0"
                               timeout_msec="30000"
                               update_msec="150"
                               initial_detection_max_age_msec="1000"
                               detection_distance_m="{gate_distance_m}"/>
      <!-- Below the role images and the top bar for the crossing. -->
      <PosSetpoint x="nan"
                   y="nan"
                   z="-1.0"/>
      <!-- Through on the heading it aligned, to 0.8 m past the gate: the
           style spin counts when passing through, and any turn before the
           gate risks a leg or the wrong side of the divider. -->
      <ForwardFixedTransit vision_distance_m="{gate_distance_m}"
                           pass_distance="0.80"
                           min_transit_distance="1.0"
                           max_planned_distance="3.90"
                           max_dist="4.25"
                           forward_velocity="0.25"
                           timeout_msec="35000"/>
      <Spin name="style"
            yaw="-12.56637061"
            rate="3.14159265"/>
      <AttSetpoint name="pool_exit_heading"
                   roll="nan"
                   pitch="nan"
                   yaw="{@gate_exit_yaw}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AlignToDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="yaw"
                  default="true">Steer yaw to zero the horizontal bearing</input_port>
      <input_port name="depth"
                  default="false">Steer depth to zero the vertical bearing</input_port>
      <input_port name="tolerance"
                  default="0.05">Aligned when |bearing| &lt;= tolerance (rad)</input_port>
      <input_port name="depth_gain"
                  default="1.5">Meters of depth change per radian of bearing</input_port>
      <input_port name="max_depth_step"
                  default="0.5">Depth correction clamp per frame (m)</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum align time before FAILURE</input_port>
    </Action>
    <Action ID="AttSetpoint">
      <input_port name="roll"
                  default="nan">Roll setpoint in radians</input_port>
      <input_port name="pitch"
                  default="nan">Pitch setpoint in radians</input_port>
      <input_port name="yaw"
                  default="nan">Yaw setpoint in radians (odom, counter-clockwise)</input_port>
      <input_port name="timeout_msec"
                  default="0">Maximum wait before FAILURE; 0 scales it with the size of the move</input_port>
    </Action>
    <Action ID="ForwardFixedTransit">
      <input_port name="vision_distance_m">Range to what is being passed through (m)</input_port>
      <input_port name="pass_distance"
                  default="0.0">Distance to carry on past it (m)</input_port>
      <input_port name="min_transit_distance"
                  default="0.0">Shortest pass (m)</input_port>
      <input_port name="max_planned_distance"
                  default="0.0">Longest pass (m); 0 for no limit</input_port>
      <input_port name="completion_tolerance_m"
                  default="0.15">Shortfall accepted at the end (m)</input_port>
      <input_port name="max_dist"
                  default="10.0">FAILURE if the pass would be longer (m)</input_port>
      <input_port name="forward_velocity"
                  default="0.3">Forward velocity (m/s)</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum time before FAILURE</input_port>
      <input_port name="min_progress_m"
                  default="0.10">Progress that shows the vehicle is moving (m)</input_port>
      <input_port name="progress_timeout_msec"
                  default="4000">FAILURE after this long without min_progress_m forward</input_port>
    </Action>
    <Action ID="LateralAlignToDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="target_distance"
                  default="1.15">Range that turns bearings into offsets (m)</input_port>
      <input_port name="use_detection_distance"
                  default="false">Use each detection's range instead of target_distance</input_port>
      <input_port name="max_projection_distance"
                  default="0.0">Cap on the range used for corrections (m); 0 for none</input_port>
      <input_port name="target_offset_left"
                  default="0.0">Aim this far left of the detection, at target_distance (m)</input_port>
      <input_port name="target_offset_up"
                  default="0.0">Aim this far above the detection, at target_distance (m)</input_port>
      <input_port name="align_depth"
                  default="true">Also center the vertical bearing, in z</input_port>
      <input_port name="lock_target"
                  default="false">Lock consistent rays into one odom target</input_port>
      <input_port name="lock_frames"
                  default="3">Rays before the target is locked</input_port>
      <input_port name="reset_timeout_on_lock"
                  default="false">Restart timeout_msec once locked</input_port>
      <input_port name="tolerance"
                  default="0.012">Centered when the bearings are within this (rad)</input_port>
      <input_port name="max_bearing_jump_rad"
                  default="0.15">Largest frame-to-frame bearing change taken as the same target</input_port>
      <input_port name="bearing_filter_alpha"
                  default="0.25">Weight of each new bearing in the filter</input_port>
      <input_port name="use_lateral_velocity_alignment"
                  default="false">Move sideways at lateral_alignment_velocity instead of in steps</input_port>
      <input_port name="lateral_alignment_velocity"
                  default="0.10">Sideways speed (m/s)</input_port>
      <input_port name="blind_alignment_frames"
                  default="1">Frames before a velocity alignment may finish without detections</input_port>
      <input_port name="max_lateral_step"
                  default="0.10">Largest sideways step per update (m)</input_port>
      <input_port name="max_depth_step"
                  default="0.08">Largest z step per update (m)</input_port>
      <input_port name="settle_frames"
                  default="8">Centered frames in a row before SUCCESS</input_port>
      <input_port name="min_msec"
                  default="1500">Minimum alignment time</input_port>
      <input_port name="timeout_msec"
                  default="15000">Maximum alignment time before FAILURE</input_port>
      <input_port name="update_msec"
                  default="300">Minimum time between corrections</input_port>
      <input_port name="initial_detection_max_age_msec"
                  default="0">Use a frame this old at the start, e.g. the one the tree waited for</input_port>
      <input_port name="detection_loss_msec"
                  default="0">FAILURE after this long without a matching frame; 0 never</input_port>
      <output_port name="detection_distance_m">The target's remaining range once aligned (m)</output_port>
    </Action>
    <Action ID="LoadModel">
      <input_port name="camera"
                  default="front">Camera whose vision node loads the model</input_port>
      <input_port name="task">Task model to load, e.g. gate</input_port>
      <input_port name="timeout_msec"
                  default="20000">Maximum wait for service + load</input_port>
    </Action>
    <Action ID="PosSetpoint">
      <input_port name="x"
                  default="nan">Odom x setpoint in meters (forward at the start)</input_port>
      <input_port name="y"
                  default="nan">Odom y setpoint in meters (left at the start)</input_port>
      <input_port name="z"
                  default="nan">Odom z setpoint in meters (up; 1 m deep is -1)</input_port>
      <input_port name="timeout_msec"
                  default="0">Maximum wait before FAILURE; 0 scales it with the size of the move</input_port>
    </Action>
    <Action ID="SavePose">
      <output_port name="x">Odom x in meters</output_port>
      <output_port name="y">Odom y in meters</output_port>
      <output_port name="yaw">Yaw in radians (odom, counter-clockwise)</output_port>
    </Action>
    <Action ID="SearchForDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="x"
                  default="nan">Forward velocity in meters per second</input_port>
      <input_port name="y"
                  default="nan">Left velocity in meters per second</input_port>
      <input_port name="z"
                  default="nan">Up velocity in meters per second</input_port>
      <input_port name="sweep_left_m"
                  default="0.0">Lateral search: distance left before turning back</input_port>
      <input_port name="sweep_right_m"
                  default="0.0">Lateral search: distance right after turning back</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum search time before FAILURE; 0 waits forever</input_port>
      <input_port name="start_timeout_after_first_frame"
                  default="false">Start the timeout with the camera's first frame instead of now</input_port>
    </Action>
    <Action ID="SelectGateRole">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="confirmation_frames"
                  default="3">Frames in a row that must show the same role</input_port>
      <input_port name="timeout_msec"
                  default="20000">Maximum wait before FAILURE</input_port>
    </Action>
    <Action ID="Spin">
      <input_port name="yaw"
                  default="-12.56637061">Yaw distance to spin in radians; positive turns left</input_port>
      <input_port name="rate"
                  default="3.14159265">Yaw rate in radians per second</input_port>
      <input_port name="timeout_msec"
                  default="0">Maximum wait before FAILURE; 0 scales it with the size of the move</input_port>
    </Action>
    <Action ID="WaitForDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="timeout_msec"
                  default="15000">Maximum wait before returning FAILURE</input_port>
      <input_port name="start_timeout_after_first_frame"
                  default="false">Start the timeout with the camera's first frame instead of now</input_port>
    </Action>
  </TreeNodesModel>

</root>
