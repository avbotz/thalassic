<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="SlalomMission">
  <BehaviorTree ID="SlalomAbortBreach">
    <Sequence name="stop_and_breach_after_slalom_failure">
      <VelocitySetpoint x="0.0"
                        y="0.0"
                        z="0.0"/>
      <PosSetpoint x="nan"
                   y="nan"
                   z="0.0"/>
      <AlwaysFailure/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlalomLayer">
    <Sequence name="scan_leftmost_pole_then_fixed_pass">
      <StationarySweepAlign camera="front"
                            task="slalom"
                            class_id="2"
                            min_score="0.70"
                            attempts="2"
                            num_sweeps="1"
                            required_pole_count="1"
                            max_left_offset_deg="45"
                            sample_timeout_msec="3500"
                            move_timeout_msec="12000"
                            transit_distance_m="{slalom_transit_distance}"/>
      <ForwardFixedTransit vision_distance_m="{slalom_transit_distance}"
                           pass_distance="{pass_distance}"
                           min_transit_distance="0.4"
                           completion_tolerance_m="0.10"
                           max_dist="{max_transit_distance}"
                           forward_velocity="0.24"
                           timeout_msec="35000"
                           min_progress_m="0.10"
                           progress_timeout_msec="4000"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlalomMission">
    <Fallback name="complete_slalom_or_breach">
      <Sequence name="slalom_mission">
        <PosSetpoint x="nan"
                     y="nan"
                     z="-1.1"/>
        <LoadModel camera="down"
                   task="path_marker"
                   timeout_msec="30000"/>
        <LoadModel camera="front"
                   task="slalom"
                   timeout_msec="30000"/>
        <SubTree ID="SlalomLayer"
                 name="slalom_layer_1"
                 max_transit_distance="5.5"
                 pass_distance="0.25"/>
        <RetryUntilSuccessful num_attempts="2">
          <SubTree ID="SlalomLayer"
                   name="slalom_layer_2"
                   max_transit_distance="5.5"
                   pass_distance="0.25"/>
        </RetryUntilSuccessful>
        <ForceSuccess>
          <SubTree ID="SlalomLayer"
                   name="slalom_layer_3"
                   max_transit_distance="5.5"
                   pass_distance="0.25"/>
        </ForceSuccess>
      </Sequence>
      <SubTree ID="SlalomAbortBreach"/>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ForwardFixedTransit">
      <input_port name="vision_distance_m">Range along the just-confirmed pole-clearance path</input_port>
      <input_port name="pass_distance"
                  default="0.0">Distance to continue past the gap plane</input_port>
      <input_port name="min_transit_distance"
                  default="0.0">Minimum safe transit distance</input_port>
      <input_port name="completion_tolerance_m"
                  default="0.15">Odometry shortfall accepted within pass margin</input_port>
      <input_port name="max_dist"
                  default="10.0">Hard transit distance safety limit</input_port>
      <input_port name="forward_velocity"
                  default="0.3">Forward velocity</input_port>
      <input_port name="timeout_msec"
                  default="30000">Transit timeout</input_port>
      <input_port name="min_progress_m"
                  default="0.10">Minimum odometry advance that proves motion</input_port>
      <input_port name="progress_timeout_msec"
                  default="4000">Maximum time without sufficient progress</input_port>
    </Action>
    <Action ID="LoadModel">
      <input_port name="camera"
                  default="front">Camera whose vision node loads the model</input_port>
      <input_port name="task">Task model to load, e.g. gate</input_port>
      <input_port name="timeout_msec"
                  default="20000">Maximum wait for service + load</input_port>
    </Action>
    <Action ID="PosSetpoint">
      <input_port name="x"
                  default="nan">North/forward position setpoint</input_port>
      <input_port name="y"
                  default="nan">East/right position setpoint</input_port>
      <input_port name="z"
                  default="nan">Vertical position setpoint; negative is down</input_port>
    </Action>
    <Action ID="StationarySweepAlign">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="attempts"
                  default="3">Stable matching frames required for an acquisition</input_port>
      <input_port name="num_sweeps"
                  default="1">Complete stationary left/right sweeps before acquisition</input_port>
      <input_port name="required_pole_count"
                  default="1">Exactly one selected pole is required</input_port>
      <input_port name="max_left_offset_deg"
                  default="45">Largest safe port-side scan offset before using the least-oblique pole</input_port>
      <input_port name="sample_timeout_msec"
                  default="1800.0">Maximum detection sampling time at each heading</input_port>
      <input_port name="move_timeout_msec"
                  default="20000">Maximum wait for each in-place yaw command</input_port>
      <output_port name="transit_distance_m">Vision range to the selected pole's right-clearance path</output_port>
    </Action>
    <Action ID="VelocitySetpoint">
      <input_port name="x"
                  default="0.0">Forward velocity in meters per second</input_port>
      <input_port name="y"
                  default="0.0">Right velocity in meters per second</input_port>
      <input_port name="z"
                  default="0.0">Up velocity in meters per second</input_port>
    </Action>
  </TreeNodesModel>

</root>
