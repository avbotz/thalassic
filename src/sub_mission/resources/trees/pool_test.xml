<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="PoolTestMission">
  <BehaviorTree ID="PoolTestMission">
    <Sequence name="pool_test_mission">
      <PosSetpoint x="nan"
                   y="nan"
                   z="-1.0"/>
      <Sleep msec="5000"/>
      <NavigateToTransform source_frame="front_camera"
                           target_frame="torps_left"
                           timeout_msec="30000"/>
      <Sleep msec="5000"/>
      <SubTree ID="AlignWithGate"/>
      <VelocitySetpoint x="0.25"
                        y="0.0"
                        z="0.0"/>
      <Sleep msec="10000"/>
      <Spin yaw="12.56637061"
            rate="3.14159265"/>
      <PosSetpoint x="nan"
                   y="nan"
                   z="-1.0"/>
      <PosSetpoint x="nan"
                   y="nan"
                   z="0.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="NavigateToTransform">
      <input_port name="source_frame">Frame whose current position is the aim point</input_port>
      <input_port name="target_frame">Attached frame to move into the source position</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum TF lookup and movement time before FAILURE</input_port>
    </Action>
    <Action ID="PosSetpoint">
      <input_port name="x"
                  default="nan">North/forward position setpoint</input_port>
      <input_port name="y"
                  default="nan">East/right position setpoint</input_port>
      <input_port name="z"
                  default="nan">Vertical position setpoint; negative is down</input_port>
    </Action>
    <Action ID="Spin">
      <input_port name="yaw"
                  default="12.56637061">Yaw distance to spin in radians</input_port>
      <input_port name="rate"
                  default="3.14159265">Yaw rate in radians per second</input_port>
    </Action>
    <Action ID="VelocitySetpoint">
      <input_port name="x"
                  default="0.0">Forward velocity in meters per second</input_port>
      <input_port name="y"
                  default="0.0">Right velocity in meters per second</input_port>
      <input_port name="z"
                  default="0.0">Up velocity in meters per second</input_port>
    </Action>
  </TreeNodesModel>

</root>
