<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared RoboSub 2026 competition run.

  Every pool_* mission sets its pool-side blackboard values (see
  missions/pool_a.xml) and then ticks THIS tree, so the task ordering lives in
  exactly one place instead of being copy-pasted into four pool files.

  Coin flip, gate, slalom, torpedoes, octagon, return home. The transit legs
  are the ones tuned in the sim (sub_sim/scenarios/woollett.scn.j2): after the
  slalom and the torpedoes, a hop forward and to the right brings the next
  element into view, and each task then finds it with its own vision search.
  Bins (trees/bins.xml, missions/bins_test.xml) is not in the run.

  Only the coin flip may end the run. Every later task runs as
  SavePose -> Fallback(Timeout(task), RecoverTaskEntry):
    - Timeout is the task's time budget. The handbook gives 15 minutes of
      performance time (20-minute slot, 5 of them preparation), so one task
      that keeps searching cannot starve the ones after it. Wall-clock ms.
    - A task that fails or runs out of time is halted wherever it was, often
      mid-sweep and facing anywhere. RecoverTaskEntry stops the vehicle and
      turns it back to the heading it had when the task began, so the next
      transit's hop still runs along the course.
  Transit legs never fail the run either: a move that times out (a current, a
  dead thruster) is logged and the next task still gets its attempt.
-->
<root BTCPP_format="4" main_tree_to_execute="CompetitionRun">
  <BehaviorTree ID="CompetitionRun">
    <Sequence name="competition_run">
      <!-- Coin flip is the only required acquisition step: if the gate cannot
           be found here, CoinFlipMission returns FAILURE and stops the run. -->
      <SubTree ID="CoinFlipMission"/>

      <SavePose name="gate_entry" yaw="{@task_entry_yaw}"/>
      <Fallback name="gate">
        <Timeout msec="120000"><SubTree ID="GateMission"/></Timeout>
        <SubTree ID="RecoverTaskEntry"/>
      </Fallback>

      <!-- The slalom searches sideways from where the gate left the vehicle. -->
      <SubTree ID="Transit" z="-1.2" x="0.0" y="0.0"/>
      <SavePose name="slalom_entry" yaw="{@task_entry_yaw}"/>
      <Fallback name="slalom">
        <Timeout msec="180000"><SubTree ID="SlalomMission"/></Timeout>
        <SubTree ID="RecoverTaskEntry"/>
      </Fallback>

      <SubTree ID="Transit" z="-1.0" x="1.5" y="-0.8"/>
      <SavePose name="torp_entry" yaw="{@task_entry_yaw}"/>
      <Fallback name="torp">
        <Timeout msec="150000"><SubTree ID="TorpMission"/></Timeout>
        <SubTree ID="RecoverTaskEntry"/>
      </Fallback>

      <SubTree ID="Transit" z="-1.0" x="3.0" y="-1.0"/>
      <SavePose name="octagon_entry" yaw="{@task_entry_yaw}"/>
      <Fallback name="octagon">
        <Timeout msec="180000"><SubTree ID="OctagonMission"/></Timeout>
        <SubTree ID="RecoverTaskEntry"/>
      </Fallback>

      <!-- Scored on its own, so it is attempted even when the octagon fails. -->
      <SavePose name="return_home_entry" yaw="{@task_entry_yaw}"/>
      <Fallback name="return_home">
        <Timeout msec="120000"><SubTree ID="ReturnHomeMission"/></Timeout>
        <SubTree ID="RecoverTaskEntry"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- A hop between tasks: stop whatever the last task left running, take
       the transit depth, then move x forward and y left along the heading.
       Each step may time out without ending the run. -->
  <BehaviorTree ID="Transit">
    <Sequence name="transit">
      <Stop/>
      <ForceSuccess><PosSetpoint z="{z}"/></ForceSuccess>
      <ForceSuccess><MoveRelative x="{x}" y="{y}"/></ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!-- After a task fails or runs out of time: stop, and face the way the
       vehicle faced when the task began. Always succeeds. -->
  <BehaviorTree ID="RecoverTaskEntry">
    <ForceSuccess>
      <Sequence name="recover_task_entry">
        <Stop/>
        <AttSetpoint name="task_entry_heading" yaw="{@task_entry_yaw}"/>
      </Sequence>
    </ForceSuccess>
  </BehaviorTree>
</root>
