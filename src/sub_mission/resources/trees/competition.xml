<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared RoboSub 2026 competition run.

  Every pool_* mission sets its pool-side blackboard values (see
  missions/pool_a.xml) and then ticks THIS tree, so the task ordering lives in
  exactly one place instead of being copy-pasted into four pool files.

  Course order and transit distances follow the sim layout in
  sub_sim/scenarios/woollett.scn.j2 (sub start y=-10.35, gate y=-7,
  slalom y~-2.8, bin y=1.1, torpedoes y=5.0, octagon y=8). "Forward" (+x) is
  the course direction, so transit legs are pure forward MoveRelative hops that
  bring the next element into view; each task subtree then re-localizes with
  its own vision search (which also absorbs the lateral offset of bins and the
  octagon). ForceSuccess lets a failed task not end the run; drop it around a
  task that must succeed.
-->
<root BTCPP_format="4" main_tree_to_execute="CompetitionRun">
  <BehaviorTree ID="CompetitionRun">
    <Sequence name="competition_run">
      <!-- Coin flip is the only required acquisition step: if the gate cannot
           be found here, CoinFlipMission returns FAILURE and stops the run. -->
      <SubTree ID="CoinFlipMission"/>
      <ForceSuccess><SubTree ID="GateMission"/></ForceSuccess>

      <!-- Gate (y=-7) -> slalom (y~-2.8): ~4 m ahead. -->
      <PosSetpoint z="-1.2"/>
      <MoveRelative x="4.0"/>
      <ForceSuccess><SubTree ID="SlalomMission"/></ForceSuccess>

      <!-- Slalom -> bin (y=1.1): ~3 m ahead; the bin sits ~3.6 m to port and
           is reacquired by BinsMission's path-marker search. -->
      <PosSetpoint z="-1.0"/>
      <MoveRelative x="3.0"/>
      <ForceSuccess><SubTree ID="BinsMission"/></ForceSuccess>

      <!-- Bin (y=1.1) -> torpedoes (y=5.0): ~3.9 m ahead. -->
      <PosSetpoint z="-1.0"/>
      <MoveRelative x="3.9"/>
      <ForceSuccess><SubTree ID="TorpMission"/></ForceSuccess>

      <!-- Torpedoes (y=5.0) -> octagon (y=8): ~3 m ahead; the octagon sits
           ~5 m to starboard and is homed by OctagonMission's search. -->
      <PosSetpoint z="-1.0"/>
      <MoveRelative x="3.0"/>
      <ForceSuccess><SubTree ID="OctagonMission"/></ForceSuccess>
    </Sequence>
  </BehaviorTree>
</root>
