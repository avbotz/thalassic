<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="CompetitionRun">
  <BehaviorTree ID="CompetitionRun">
    <Fallback>
      <Sequence name="competition_run">
        <SubTree ID="CoinFlipMission"/>
        <SubTree ID="GateMission"/>
        <PosSetpoint x="nan"
                     y="nan"
                     z="-1.2"/>
        <MoveRelative x="3.0"
                      y="0.0"
                      z="0.0"/>
        <SubTree ID="SlalomMission"/>
        <PosSetpoint x="nan"
                     y="nan"
                     z="-1.0"/>
        <MoveRelative x="3.0"
                      y="0.0"
                      z="0.0"/>
        <ForceSuccess>
          <SubTree ID="BinsMission"/>
        </ForceSuccess>
        <PosSetpoint x="nan"
                     y="nan"
                     z="-1.0"/>
        <MoveRelative x="3.9"
                      y="0.0"
                      z="0.0"/>
        <ForceSuccess>
          <SubTree ID="TorpMission"/>
        </ForceSuccess>
        <PosSetpoint x="nan"
                     y="nan"
                     z="-1.0"/>
        <MoveRelative x="3.0"
                      y="0.0"
                      z="0.0"/>
        <ForceSuccess>
          <SubTree ID="OctagonMission"/>
        </ForceSuccess>
      </Sequence>
      <Sequence>
        <PosSetpoint x="nan"
                     y="nan"
                     z="0.0"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="MoveRelative">
      <input_port name="x"
                  default="0.0">Forward offset in meters</input_port>
      <input_port name="y"
                  default="0.0">Right offset in meters</input_port>
      <input_port name="z"
                  default="0.0">Vertical offset in meters; negative is down</input_port>
    </Action>
    <Action ID="PosSetpoint">
      <input_port name="x"
                  default="nan">North/forward position setpoint</input_port>
      <input_port name="y"
                  default="nan">East/right position setpoint</input_port>
      <input_port name="z"
                  default="nan">Vertical position setpoint; negative is down</input_port>
    </Action>
  </TreeNodesModel>

</root>
