<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BinsMission">
  <BehaviorTree ID="BinsMission">
    <Sequence name="bins_mission">
      <PosSetpoint x="nan"
                   y="nan"
                   z="-0.5"/>
      <LoadModel camera="down"
                 task="torp_fire_blood"
                 timeout_msec="30000"/>
      <!-- Survey & Repair: fire (0); Search & Rescue: blood (1). -->
      <Fallback name="service_role_bins">
        <Sequence name="service_survey_bins">
          <SurveyRole/>
          <SubTree ID="DropMarkerInBin" class_id="0" dropper_id="0"/>
          <!-- Advance past the first bin before locating the second. -->
          <PosSetpoint x="nan" y="nan" z="-0.5"/>
          <MoveRelative x="2.0" y="0.0" z="0.0"/>
          <SubTree ID="DropMarkerInBin" class_id="0" dropper_id="1"/>
        </Sequence>
        <Sequence name="service_search_bins">
          <SearchRole/>
          <SubTree ID="DropMarkerInBin" class_id="1" dropper_id="0"/>
          <!-- Advance past the first bin before locating the second. -->
          <PosSetpoint x="nan" y="nan" z="-0.5"/>
          <MoveRelative x="2.0" y="0.0" z="0.0"/>
          <SubTree ID="DropMarkerInBin" class_id="1" dropper_id="1"/>
        </Sequence>
      </Fallback>
      <MoveRelative x="1.0"
                    y="0.0"
                    z="0.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- Find and service one bin of the selected role. -->
  <BehaviorTree ID="DropMarkerInBin">
    <Sequence name="drop_marker_in_bin">
      <Fallback name="find_role_bin">
        <DownForwardSweepAlign task="torp_fire_blood"
                               class_id="{class_id}"
                               min_score="0.35"
                               max_dist="20.0"
                               forward_step="0.5"
                               default_distance="1.0"
                               center_gain="1.0"
                               orient="false"
                               lateral_sweep_step="1.0"
                               update_msec="300"
                               timeout_msec="15000"/>
        <DownPatternScan task="torp_fire_blood"
                         class_id="{class_id}"
                         min_score="0.35"
                         movement_dist="1.65"
                         sample_timeout_msec="2500"
                         move_timeout_msec="20000"/>
      </Fallback>
      <DownContinuousAlign task="torp_fire_blood"
                           class_id="{class_id}"
                           min_score="0.45"
                           tolerance="0.12"
                           desired_distance="nan"
                           default_distance="1.0"
                           center_gain="1.0"
                           orient="false"
                           min_msec="2500"
                           timeout_msec="30000"
                           update_msec="200"/>
      <!-- DownContinuousAlign centers the camera on the selected bin image.
           Shift by the measured camera-to-dropper transform, then wait until
           NavigateToTransform has controller-confirmed the final position. -->
      <NavigateToTransform source_frame="down_camera"
                           target_frame="dropper_link"
                           timeout_msec="30000"/>
      <Sleep msec="1000"/>
      <DropBalls dropper_id="{dropper_id}"
                 open="true"
                 timeout_msec="5000"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="SearchRole">Succeeds when the launch-time role is SEARCH</Condition>
    <Condition ID="SurveyRole">Succeeds when the launch-time role is SURVEY</Condition>
    <Action ID="DownContinuousAlign">
      <input_port name="task">Only accept down-camera detections from this task</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="tolerance"
                  default="0.35">Centered when both bearings are within tolerance (rad)</input_port>
      <input_port name="desired_distance"
                  default="nan">Optional camera-to-object distance to hold in meters</input_port>
      <input_port name="distance_tolerance"
                  default="0.5">Distance error allowed at completion (m)</input_port>
      <input_port name="default_distance"
                  default="1.0">Distance used when detection distance is unavailable</input_port>
      <input_port name="center_gain"
                  default="1.0">Scale factor for down-camera x/y centering offsets</input_port>
      <input_port name="orient"
                  default="true">Yaw to detection orientation metadata when present</input_port>
      <input_port name="require_orientation"
                  default="false">Fail on timeout instead of accepting center-only alignment when orientation is absent</input_port>
      <input_port name="orientation_settle_frames"
                  default="3">Consecutive consistent orientation frames required before yawing</input_port>
      <input_port name="orientation_consistency_deg"
                  default="10.0">Maximum frame-to-frame axial-angle change accepted as consistent</input_port>
      <input_port name="orient_tolerance_deg"
                  default="5.0">Orientation error allowed at completion</input_port>
      <input_port name="min_msec"
                  default="3000">Minimum closed-loop alignment time</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum align time before FAILURE</input_port>
      <input_port name="update_msec"
                  default="200">Minimum time between movement corrections</input_port>
    </Action>
    <Action ID="DownForwardSweepAlign">
      <input_port name="task">Only accept detections from this task</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="max_dist"
                  default="10.0">Maximum forward travel before SUCCESS</input_port>
      <input_port name="forward_step"
                  default="1.0">Forward target extension per update in meters</input_port>
      <input_port name="default_distance"
                  default="1.0">Distance used when detection distance is unavailable</input_port>
      <input_port name="center_gain"
                  default="1.0">Scale factor for down-camera x/y centering offsets</input_port>
      <input_port name="orient"
                  default="false">Follow detection orientation metadata</input_port>
      <input_port name="lateral_sweep_step"
                  default="1.0">Right/left search step when no down-camera detection is visible</input_port>
      <input_port name="stop_camera">Succeed when this camera sees the stop target</input_port>
      <input_port name="stop_task">Succeed when this task is detected (empty disables)</input_port>
      <input_port name="stop_class_id">Only accept this stop-target class id</input_port>
      <input_port name="stop_min_score"
                  default="0.0">Minimum stop-target detection confidence</input_port>
      <input_port name="update_msec"
                  default="300">Minimum time between movement corrections</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum scan time before FAILURE</input_port>
    </Action>
    <Action ID="DownPatternScan">
      <input_port name="task">Task model to search for with the down camera</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="movement_dist"
                  default="1.65">Search-pattern movement distance in meters</input_port>
      <input_port name="sample_timeout_msec"
                  default="2500">Maximum detection sample time at each point</input_port>
      <input_port name="move_timeout_msec"
                  default="20000">Maximum wait for each pattern move</input_port>
    </Action>
    <Action ID="DropBalls">
      <input_port name="dropper_id"
                  default="0">Dropper id to command</input_port>
      <input_port name="open"
                  default="true">Dropper state to command</input_port>
      <input_port name="timeout_msec"
                  default="5000">Maximum wait for set_dropper response</input_port>
    </Action>
    <Action ID="LoadModel">
      <input_port name="camera"
                  default="front">Camera whose vision node loads the model</input_port>
      <input_port name="task">Task model to load, e.g. gate</input_port>
      <input_port name="timeout_msec"
                  default="20000">Maximum wait for service + load</input_port>
    </Action>
    <Action ID="MoveRelative">
      <input_port name="x"
                  default="0.0">Forward offset in meters</input_port>
      <input_port name="y"
                  default="0.0">Right offset in meters</input_port>
      <input_port name="z"
                  default="0.0">Vertical offset in meters; negative is down</input_port>
    </Action>
    <Action ID="NavigateToTransform">
      <input_port name="source_frame">Frame whose current position is the aim point</input_port>
      <input_port name="target_frame">Attached frame to move into the source position</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum TF lookup and movement time before FAILURE</input_port>
    </Action>
    <Action ID="PosSetpoint">
      <input_port name="x"
                  default="nan">North/forward position setpoint</input_port>
      <input_port name="y"
                  default="nan">East/right position setpoint</input_port>
      <input_port name="z"
                  default="nan">Vertical position setpoint; negative is down</input_port>
    </Action>
    <Action ID="VelocitySetpoint">
      <input_port name="x"
                  default="0.0">Forward velocity in meters per second</input_port>
      <input_port name="y"
                  default="0.0">Right velocity in meters per second</input_port>
      <input_port name="z"
                  default="0.0">Up velocity in meters per second</input_port>
    </Action>
  </TreeNodesModel>

</root>
