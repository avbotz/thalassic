<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BinsMission">
  <BehaviorTree ID="BinsMission">
    <Sequence name="bins_mission">
      <FindPathMarkerForBins/>
      <AlignAboveBinsPathMarker/>
      <PosSetpoint z="0.5"/>
      <PosSetpoint x="2.2" velocity="true"/>
      <FindBins/>
      <AlignOverBins/>
      <!-- Center over the {@target_animal} half before dropping. -->
      <AlignOverBinTarget/>
      <PosSetpoint z="0.6" use_altitude="true"/>
      <DropBalls/>
    </Sequence>
  </BehaviorTree>
</root>
