<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="TorpMission">
  <BehaviorTree ID="TorpMission">
    <Sequence name="torp_mission">
      <AltitudeSetpoint z="1.0"/>
      <AttSetpoint name="torp_search_heading" yaw="{@torp_search_yaw}"/>
      <Fallback name="find_torp_board">
        <SearchTorpBoard/>
        <RecoverTorpBoardSearch/>
      </Fallback>
      <VerifyTorpBoard/>
      <ApproachTorpBoard/>
      <OrientToTorpBoard/>
      <ShootChosenTorpHole/>
      <VelocitySetpoint x="-1.5"/>
      <ShootOtherTorpHole/>
      <VelocitySetpoint x="-1.5"/>
      <PosSetpoint z="1.0"/>
    </Sequence>
  </BehaviorTree>
</root>
