<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="TorpMission">
  <BehaviorTree ID="TorpMission">
    <Sequence name="torp_mission">
      <PosSetpoint x="nan"
                   y="nan"
                   z="-1.0"/>
      <AttSetpoint name="torp_search_heading"
                   roll="nan"
                   pitch="nan"
                   yaw="{@torp_search_yaw}"/>
      <LoadModel camera="front"
                 task="torp"
                 timeout_msec="30000"/>
      <Fallback name="find_torp_board">
        <ForwardSweepAlign camera="front"
                           task="torp"
                           class_id=""
                           min_score="0.2"
                           attempts="4"
                           num_sweeps="4"
                           forward_step="2.0"
                           sample_timeout_msec="2500.0"
                           move_timeout_msec="20000"/>
        <Sequence name="recover_torp_board_search">
          <MoveRelative x="-0.2"
                        y="0.0"
                        z="-0.1"/>
          <ForwardSweepAlign camera="front"
                             task="torp"
                             class_id=""
                             min_score="0.0"
                             attempts="8"
                             num_sweeps="3"
                             forward_step="2.0"
                             sample_timeout_msec="2500.0"
                             move_timeout_msec="20000"/>
        </Sequence>
      </Fallback>
      <MoveRelative x="0.5"
                    y="0.0"
                    z="0.0"/>
      <Fallback name="verify_torp_board">
        <AlignToDetection camera="front"
                          task="torp"
                          class_id=""
                          min_score="0.01"
                          yaw="true"
                          depth="false"
                          tolerance="0.3"
                          depth_gain="1.5"
                          max_depth_step="0.5"
                          timeout_msec="10000"/>
        <ForwardSweepAlign camera="front"
                           task="torp"
                           class_id=""
                           min_score="0.1"
                           attempts="4"
                           num_sweeps="4"
                           forward_step="2.0"
                           sample_timeout_msec="2500.0"
                           move_timeout_msec="20000"/>
      </Fallback>
      <ForwardContinuousAlign camera="front"
                              task="torp"
                              class_id="0"
                              min_score="0.2"
                              max_dist="4.0"
                              forward_velocity="0.6"
                              close_distance="2.4"
                              detection_loss_msec="3000"
                              timeout_msec="15000"
                              confirmation_frames="1"
                              continue_on_loss="false"
                              stop_on_close="true"
                              loss_is_success="true"
                              loss_min_travel="0.0"
                              timeout_is_success="true"
                              max_dist_is_success="true"
                              max_yaw_step_deg="35.0"
                              fixed_distance_from_detection="false"
                              pass_distance="0.0"
                              min_transit_distance="0.0"/>
      <!-- At the nominal stand-off this normally succeeds without moving.
           If the board has filled or left the camera FOV, retreat once before
           asking PnP to recover its board-normal pose. -->
      <Fallback>
        <WaitForDetection camera="front"
                          task="torp"
                          class_id="0"
                          min_score="0.2"
                          timeout_msec="1500"/>
        <Sequence name="backoff_and_reacquire_torp_board">
          <MoveRelative x="-0.4"
                        y="0.0"
                        z="0.0"/>
          <ForceSuccess>
            <WaitForDetection camera="front"
                              task="torp"
                              class_id="0"
                              min_score="0.1"
                              timeout_msec="5000"/>
          </ForceSuccess>
        </Sequence>
      </Fallback>
      <RetryUntilSuccessful num_attempts="2">
        <OrientToDetectionAtDist camera="front"
                                 task="torp"
                                 class_id="0"
                                 min_score="0.1"
                                 desired_distance="0.95"
                                 max_detection_distance="4.0"
                                 tolerance="0.08"
                                 distance_tolerance="0.08"
                                 orient_tolerance_deg="5.0"
                                 max_position_step="0.60"
                                 require_heading="true"
                                 settle_frames="3"
                                 min_msec="3000"
                                 timeout_msec="40000"
                                 update_msec="300"/>
      </RetryUntilSuccessful>
      <!-- Only the board is detectable.  These are fixed competition-board
           offsets from the visually aligned camera aim point. -->
      <MoveRelative x="0.5"
                    y="0.0"
                    z="0.0"/>
      <NavigateToTransform source_frame="front_camera"
                           target_frame="torps_left"
                           timeout_msec="30000"/>
      <ShootTorpedo torpedo_id="0"
                    open="true"
                    timeout_msec="5000"/>
      <!-- Restore the camera aim point before applying the second fixed offset. -->
      <NavigateToTransform source_frame="torps_left"
                           target_frame="front_camera"
                           timeout_msec="30000"/>
      <MoveRelative x="0.0"
                    y="0.15"
                    z="0.0"/>
      <NavigateToTransform source_frame="front_camera"
                           target_frame="torps_right"
                           timeout_msec="30000"/>
      <ShootTorpedo torpedo_id="1"
                    open="true"
                    timeout_msec="5000"/>
      <VelocitySetpoint x="-1.5"
                        y="0.0"
                        z="0.0"/>
      <PosSetpoint x="nan"
                   y="nan"
                   z="-1.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AlignToDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="yaw"
                  default="true">Steer yaw to zero the horizontal bearing</input_port>
      <input_port name="depth"
                  default="false">Steer depth to zero the vertical bearing</input_port>
      <input_port name="tolerance"
                  default="0.05">Aligned when |bearing| &lt;= tolerance (rad)</input_port>
      <input_port name="depth_gain"
                  default="1.5">Meters of depth change per radian of bearing</input_port>
      <input_port name="max_depth_step"
                  default="0.5">Depth correction clamp per frame (m)</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum align time before FAILURE</input_port>
    </Action>
    <Action ID="AttSetpoint">
      <input_port name="roll"
                  default="nan">Roll setpoint in radians</input_port>
      <input_port name="pitch"
                  default="nan">Pitch setpoint in radians</input_port>
      <input_port name="yaw"
                  default="nan">Yaw setpoint in radians</input_port>
    </Action>
    <Action ID="ForwardContinuousAlign">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="max_dist"
                  default="10.0">Maximum forward travel before SUCCESS</input_port>
      <input_port name="forward_velocity"
                  default="1.0">Fixed body-forward velocity in meters per second</input_port>
      <input_port name="close_distance"
                  default="3.0">Distance that completes the approach</input_port>
      <input_port name="detection_loss_msec"
                  default="3000">Target-loss time that completes the approach</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum align time before SUCCESS</input_port>
      <input_port name="confirmation_frames"
                  default="1">Matching frames required before propulsion</input_port>
      <input_port name="continue_on_loss"
                  default="true">Continue on the last heading after target loss</input_port>
      <input_port name="stop_on_close"
                  default="true">Stop immediately when the target is close</input_port>
      <input_port name="loss_is_success"
                  default="false">Accept target loss only after a confirmed close pass</input_port>
      <input_port name="loss_min_travel"
                  default="0.0">Minimum odom travel before a post-close loss can succeed</input_port>
      <input_port name="timeout_is_success"
                  default="true">Treat bounded timeout as SUCCESS</input_port>
      <input_port name="max_dist_is_success"
                  default="true">Treat maximum travel as SUCCESS</input_port>
      <input_port name="max_yaw_step_deg"
                  default="45.0">Maximum heading correction per frame</input_port>
      <input_port name="fixed_distance_from_detection"
                  default="false">Lock transit distance from confirmed vision range</input_port>
      <input_port name="pass_distance"
                  default="0.0">Meters to continue beyond detected gap plane</input_port>
      <input_port name="min_transit_distance"
                  default="0.0">Minimum safe fixed transit distance</input_port>
    </Action>
    <Action ID="ForwardSweepAlign">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="attempts"
                  default="4">Detection frames sampled at each yaw</input_port>
      <input_port name="num_sweeps"
                  default="3">Forward sweep passes before FAILURE</input_port>
      <input_port name="forward_step"
                  default="2.0">Forward move between sweeps in meters</input_port>
      <input_port name="sample_timeout_msec"
                  default="2500.0">Maximum detection sample time per yaw</input_port>
      <input_port name="move_timeout_msec"
                  default="20000">Maximum wait for each commanded movement</input_port>
    </Action>
    <Action ID="WaitForDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="timeout_msec"
                  default="15000">Maximum wait before returning FAILURE</input_port>
    </Action>
    <Action ID="LateralAlignToDetection">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="use_board_aim_bearing"
                  default="false">Use calibrated fixed-hole bearings published with a board detection</input_port>
      <input_port name="lock_board_aim"
                  default="false">Lock three consistent aim rays into an odom-frame lateral/depth target</input_port>
      <input_port name="target_distance"
                  default="1.15">Camera-to-target plane distance used to project pixel bearings</input_port>
      <input_port name="target_offset_right_m"
                  default="0.0">Fixed target offset to camera-right from the detected item, in meters</input_port>
      <input_port name="target_offset_down_m"
                  default="0.0">Fixed target offset downward from the detected item, in meters</input_port>
      <input_port name="tolerance"
                  default="0.012">Centered when horizontal and vertical bearing are within this radian bound</input_port>
      <input_port name="max_lateral_step"
                  default="0.10">Maximum body-lateral correction per update in meters</input_port>
      <input_port name="max_depth_step"
                  default="0.08">Maximum vertical correction per update in meters</input_port>
      <input_port name="settle_frames"
                  default="8">Consecutive centered model detections required before SUCCESS</input_port>
      <input_port name="min_msec"
                  default="1500">Minimum closed-loop alignment time</input_port>
      <input_port name="timeout_msec"
                  default="15000">Maximum alignment time before FAILURE</input_port>
      <input_port name="update_msec"
                  default="300">Minimum time between translation corrections</input_port>
    </Action>
    <Action ID="LoadModel">
      <input_port name="camera"
                  default="front">Camera whose vision node loads the model</input_port>
      <input_port name="task">Task model to load, e.g. gate</input_port>
      <input_port name="timeout_msec"
                  default="20000">Maximum wait for service + load</input_port>
    </Action>
    <Action ID="MoveRelative">
      <input_port name="x"
                  default="0.0">Forward offset in meters</input_port>
      <input_port name="y"
                  default="0.0">Right offset in meters</input_port>
      <input_port name="z"
                  default="0.0">Vertical offset in meters; negative is down</input_port>
    </Action>
    <Action ID="NavigateToTransform">
      <input_port name="source_frame">Frame whose current position is the aim point</input_port>
      <input_port name="target_frame">Attached frame to move into the source position</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum TF lookup and movement time before FAILURE</input_port>
    </Action>
    <Action ID="OrientToDetectionAtDist">
      <input_port name="camera"
                  default="front">Detection source: front or down</input_port>
      <input_port name="task">Only accept detections from this task's model</input_port>
      <input_port name="class_id">Only accept this class id (empty = any)</input_port>
      <input_port name="min_score"
                  default="0.0">Minimum detection confidence</input_port>
      <input_port name="desired_distance"
                  default="2.0">Distance to hold from the target in meters</input_port>
      <input_port name="max_detection_distance"
                  default="0.0">Reject pose observations beyond this range; zero disables the bound</input_port>
      <input_port name="tolerance"
                  default="0.35">Centered when |horizontal bearing| &lt;= tolerance (rad)</input_port>
      <input_port name="distance_tolerance"
                  default="0.5">Distance error allowed at completion (m)</input_port>
      <input_port name="orient_tolerance_deg"
                  default="5.0">Orientation error allowed at completion</input_port>
      <input_port name="max_position_step"
                  default="0.5">Maximum translation correction per update (m)</input_port>
      <input_port name="require_heading"
                  default="false">Fail when no calibrated board-normal heading is available</input_port>
      <input_port name="settle_frames"
                  default="1">Consecutive in-tolerance detection frames required before SUCCESS</input_port>
      <input_port name="min_msec"
                  default="6500">Minimum closed-loop alignment time</input_port>
      <input_port name="timeout_msec"
                  default="30000">Maximum align time before FAILURE</input_port>
      <input_port name="update_msec"
                  default="300">Minimum time between movement corrections</input_port>
    </Action>
    <Action ID="PosSetpoint">
      <input_port name="x"
                  default="nan">North/forward position setpoint</input_port>
      <input_port name="y"
                  default="nan">East/right position setpoint</input_port>
      <input_port name="z"
                  default="nan">Vertical position setpoint; negative is down</input_port>
    </Action>
    <Action ID="ShootTorpedo">
      <input_port name="torpedo_id">Torpedo id to command</input_port>
      <input_port name="open"
                  default="true">Torpedo thruster state to command</input_port>
      <input_port name="timeout_msec"
                  default="5000">Maximum wait for launch_torpedo response</input_port>
    </Action>
    <Action ID="VelocitySetpoint">
      <input_port name="x"
                  default="0.0">Forward velocity in meters per second</input_port>
      <input_port name="y"
                  default="0.0">Right velocity in meters per second</input_port>
      <input_port name="z"
                  default="0.0">Up velocity in meters per second</input_port>
    </Action>
    <Condition ID="TorpBoardV1">Succeeds when launch-time torp_board_type is v1</Condition>
  </TreeNodesModel>

</root>
