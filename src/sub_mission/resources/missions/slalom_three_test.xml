<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="SlalomThreeLayerTest">
  <!-- Direct simulator regression for the yaw-locked SlalomLayer tree. -->
  <BehaviorTree ID="SlalomThreeLayerTest">
    <Sequence name="yaw_locked_three_layer_slalom">
      <!-- This test starts at the post-gate handoff depth, so do not wait for
           an unrelated depth move before beginning red-pole acquisition. -->
      <LoadModel camera="front" task="slalom_redpoles_osu" timeout_msec="30000"/>
      <SubTree ID="SlalomLayer" name="test_slalom_layer_1"
               pole_class_id="2" search_lateral_velocity="0.10"
               search_left_distance_m="5.0" search_right_distance_m="10.0"
               search_timeout_msec="140000"
               max_transit_distance="6.0"/>
      <TimedVelocity x="0.0" y="0.0" z="-0.10" duration_msec="2000"/>
      <SubTree ID="SlalomLayer" name="test_slalom_layer_2"
               pole_class_id="2" search_lateral_velocity="-0.10"
               search_left_distance_m="0.0" search_right_distance_m="0.0"
               search_timeout_msec="10000"
               max_transit_distance="6.0"/>
      <SubTree ID="SlalomLayer" name="test_slalom_layer_3"
               pole_class_id="2" search_lateral_velocity="-0.10"
               search_left_distance_m="0.0" search_right_distance_m="0.0"
               search_timeout_msec="0"
               max_transit_distance="6.0"/>
    </Sequence>
  </BehaviorTree>
</root>
