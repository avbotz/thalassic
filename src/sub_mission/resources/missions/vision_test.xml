<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vision integration smoke test: loads a task model on the front camera and
  confirms detections stream back. It commands no motion, but like every
  mission it starts only once the kill switch is released and ends on a kill,
  and sub_control holds the vehicle where it is meanwhile. To cover another
  model, add its LoadModel + WaitForDetection pair to the sequence.
-->
<root BTCPP_format="4" main_tree_to_execute="VisionTestMission">
  <BehaviorTree ID="VisionTestMission">
    <Sequence name="vision_test_mission">
      <LoadModel task="gate" timeout_msec="30000"/>
      <WaitForDetection task="gate" timeout_msec="20000"/>
    </Sequence>
  </BehaviorTree>
</root>
