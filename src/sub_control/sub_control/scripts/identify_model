#!/usr/bin/env python3
"""Identify sub_control's vehicle model from open-loop steps.

See docs/control.md#identifying-the-model. With the stack running and the
vehicle unkilled in open water (2 m or more from walls and the bottom):

    ros2 run sub_control identify_model --ros-args -r __ns:=/marlin_v3

It holds depth, then for each axis pushes open loop (MotionSetpoint EFFORT) at
each effort in both directions, recording the thrust actually produced
(control/status) and the motion (odometry/filtered), and fits

    x, y, z, yaw:  tau = m dv/dt + d_l v + d_q v|v| + c
    roll, pitch:   tau = J dw/dt + d_l w + k_s sin(angle) + k_c cos(angle)

by least squares. It prints a `model:` block for the gains file. Rerun it
whenever the hull's mass, trim or shape changes.
"""

import math
import sys
import threading
import time

import numpy as np
import rclpy
from nav_msgs.msg import Odometry
from rclpy.executors import MultiThreadedExecutor
from rclpy.node import Node
from rclpy.signals import SignalHandlerOptions
from sub_control_interfaces.msg import ControllerStatus, MotionSetpoint

AXES = ["x", "y", "z", "roll", "pitch", "yaw"]
TRANSLATION = {"x": 0, "y": 1, "z": 2}
ROTATION = {"roll": 3, "pitch": 4, "yaw": 5}


def quaternion_to_rpy(q) -> tuple[float, float, float]:
    roll = math.atan2(2 * (q.w * q.x + q.y * q.z), 1 - 2 * (q.x * q.x + q.y * q.y))
    pitch = math.asin(max(-1.0, min(1.0, 2 * (q.w * q.y - q.z * q.x))))
    yaw = math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z))
    return roll, pitch, yaw


def smooth(values: np.ndarray, samples: int) -> np.ndarray:
    if samples <= 1:
        return values
    kernel = np.ones(samples) / samples
    padded = np.pad(values, samples // 2, mode="edge")
    return np.convolve(padded, kernel, mode="valid")[: len(values)]


def least_squares(columns: dict[str, np.ndarray], target: np.ndarray, nonnegative: tuple[str, ...]):
    """Least squares with the named coefficients kept >= 0 (by dropping any that come out negative)."""
    names = list(columns)
    while True:
        a = np.column_stack([columns[n] for n in names])
        solution, *_ = np.linalg.lstsq(a, target, rcond=None)
        negative = [n for n, v in zip(names, solution, strict=True) if n in nonnegative and v < 0]
        if not negative:
            break
        names.remove(negative[0])
    residual = target - a @ solution
    r_squared = 1.0 - residual.var() / max(target.var(), 1e-12)
    fit = dict.fromkeys(columns, 0.0)
    fit.update(zip(names, solution, strict=True))
    return fit, r_squared, math.sqrt(float(np.mean(residual**2)))


class Identifier(Node):
    def __init__(self):
        super().__init__("identify_model")
        self.declare_parameter("axes", ["z", "x", "y", "yaw", "roll", "pitch"])
        self.declare_parameter("depth", 1.5)  # [m] to work at
        self.declare_parameter("min_depth", 0.5)  # [m] a step stops shallower than this
        self.declare_parameter("max_tilt", 0.6)  # [rad] a step stops tilted more than this
        self.declare_parameter("settle", 8.0)  # [s] holding between steps
        self.declare_parameter("response_time", 0.15)  # [s] thrust lag behind the command
        # Buoyancy [N] (about the weight) to turn the fitted moments into a
        # centre-of-buoyancy offset; 0 prints the moments only.
        self.declare_parameter("buoyancy", 0.0)
        for axis, efforts, seconds in (
            ("x", [12.0, 25.0], 6.0),
            ("y", [12.0, 25.0], 6.0),
            ("z", [8.0, 16.0], 4.0),
            ("roll", [1.5, 3.0], 5.0),
            ("pitch", [1.5, 3.0], 5.0),
            ("yaw", [2.0, 4.0], 5.0),
        ):
            self.declare_parameter(f"{axis}.efforts", efforts)  # [N] or [N m], each tried both ways
            self.declare_parameter(f"{axis}.duration", seconds)  # [s] per step
        # Now, not minutes into the session when that axis comes up.
        unknown = [a for a in self.get_parameter("axes").value if a not in AXES]
        if unknown:
            raise ValueError(f"axes: unknown {unknown}; choose from {AXES}")

        self.status: ControllerStatus | None = None
        self.odom: Odometry | None = None
        self.recording: list | None = None
        self.lock = threading.Lock()
        self.create_subscription(ControllerStatus, "control/status", self.on_status, 50)
        self.create_subscription(Odometry, "odometry/filtered", self.on_odom, 50)
        self.publisher = self.create_publisher(MotionSetpoint, "motion_setpoint", 10)

    def on_odom(self, msg: Odometry):
        self.odom = msg

    def on_status(self, msg: ControllerStatus):
        self.status = msg
        o = self.odom
        if o is None:
            return
        t = msg.header.stamp.sec + 1e-9 * msg.header.stamp.nanosec
        rpy = quaternion_to_rpy(o.pose.pose.orientation)
        tw = o.twist.twist
        row = (
            t,
            *msg.wrench_achieved,
            tw.linear.x,
            tw.linear.y,
            tw.linear.z,
            tw.angular.x,
            tw.angular.y,
            tw.angular.z,
            *rpy,
            -o.pose.pose.position.z,
        )
        # Checked under the lock: the main thread ends a recording by setting it to None.
        with self.lock:
            if self.recording is not None:
                self.recording.append(row)

    def sim_now(self) -> float:
        return self.get_clock().now().nanoseconds * 1e-9

    def sleep(self, seconds: float):
        end = self.sim_now() + seconds
        while rclpy.ok() and self.sim_now() < end:
            time.sleep(0.01)

    def send(self, modes, position=None, effort=None, timeout=0.0):
        msg = MotionSetpoint()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.mode = list(modes)
        msg.position = list(position if position is not None else [0.0] * 6)
        msg.effort = list(effort if effort is not None else [0.0] * 6)
        msg.timeout = timeout
        self.publisher.publish(msg)

    def hold(self, depth: float):
        """Hold x/y where they are, depth, level and the current heading."""
        self.send(
            [MotionSetpoint.HOLD] * 2 + [MotionSetpoint.POSITION] * 3 + [MotionSetpoint.HOLD],
            position=[0.0, 0.0, -depth, 0.0, 0.0, 0.0],
        )

    def held_wrench(self, seconds: float) -> np.ndarray:
        """Average thrust while holding: what the vehicle needs to stay put."""
        with self.lock:
            self.recording = []
        self.sleep(seconds)
        with self.lock:
            data, self.recording = np.array(self.recording), None
        if len(data) == 0:
            raise RuntimeError("no control/status and odometry/filtered while holding")
        return data[len(data) // 2 :, 1:7].mean(axis=0)

    def step(self, axis: str, effort: np.ndarray, seconds: float) -> np.ndarray:
        index = AXES.index(axis)
        modes = [MotionSetpoint.KEEP] * 6
        modes[index] = MotionSetpoint.EFFORT
        if index < 2:
            modes[0] = modes[1] = MotionSetpoint.EFFORT  # x and y share a mode
        with self.lock:
            self.recording = []
        end = self.sim_now() + seconds
        min_depth = self.get_parameter("min_depth").value
        max_tilt = self.get_parameter("max_tilt").value
        while rclpy.ok() and self.sim_now() < end:
            self.send(modes, effort=effort, timeout=0.5)
            o = self.odom
            if o is not None:
                roll, pitch, _ = quaternion_to_rpy(o.pose.pose.orientation)
                if -o.pose.pose.position.z < min_depth or max(abs(roll), abs(pitch)) > max_tilt:
                    self.get_logger().warning(f"{axis} step stopped early: too shallow or tilted")
                    break
            time.sleep(0.05)
        with self.lock:
            data, self.recording = np.array(self.recording), None
        return data

    def fit(self, axis: str, runs: list[np.ndarray]) -> tuple[dict, float, float] | None:
        """The axis's model, R^2 and rms residual; None if no run was long enough to fit."""
        index = AXES.index(axis)
        lag = self.get_parameter("response_time").value
        columns: dict[str, list] = {}
        target = []
        for data in runs:
            if len(data) < 20:
                continue
            t = data[:, 0]
            dt = float(np.median(np.diff(t)))
            samples = max(1, int(round(0.3 / dt)))
            # The thrust reaches the vehicle `lag` after it is commanded.
            tau = np.interp(t - lag, t, data[:, 1 + index])
            speed = smooth(data[:, 7 + index], samples)
            accel = np.gradient(speed, t)
            keep = slice(samples, len(t) - samples)  # drop the smoothing's edges
            rows = {"inertia": accel, "linear_drag": speed}
            if axis in ("roll", "pitch"):
                angle = data[:, 13 + index - 3]
                rows["righting"] = np.sin(angle)
                rows["trim"] = np.cos(angle)
            else:
                rows["quadratic_drag"] = speed * np.abs(speed)
                rows["bias"] = np.ones_like(t)
            for name, values in rows.items():
                columns.setdefault(name, []).append(values[keep])
            target.append(tau[keep])
        if not target:
            return None
        stacked = {n: np.concatenate(v) for n, v in columns.items()}
        return least_squares(
            stacked, np.concatenate(target), ("inertia", "linear_drag", "quadratic_drag")
        )

    def run(self):
        while rclpy.ok() and (self.status is None or self.status.killed or self.odom is None):
            self.get_logger().info(
                "waiting for sub_control to be running and unkilled...", throttle_duration_sec=5.0
            )
            time.sleep(0.2)
        depth = self.get_parameter("depth").value
        settle = self.get_parameter("settle").value
        self.get_logger().info(f"going to {depth} m")
        self.hold(depth)
        self.sleep(3.0 * settle)
        hold = self.held_wrench(settle)
        self.get_logger().info(
            "holding needs " + ", ".join(f"{a}={v:+.2f}" for a, v in zip(AXES, hold, strict=True))
        )

        results = {}
        for axis in self.get_parameter("axes").value:
            index = AXES.index(axis)
            runs = []
            for magnitude in self.get_parameter(f"{axis}.efforts").value:
                for sign in (1.0, -1.0):
                    effort = np.zeros(6)
                    effort[index] = hold[index] + sign * magnitude
                    self.get_logger().info(f"{axis}: pushing {effort[index]:+.1f}")
                    runs.append(
                        self.step(axis, effort, self.get_parameter(f"{axis}.duration").value)
                    )
                    self.hold(depth)
                    self.sleep(settle)
            fitted = self.fit(axis, runs)
            if fitted is None:
                self.get_logger().error(f"{axis}: every step stopped too early to fit; left out")
                continue
            results[axis] = fitted
            fit, r2, rms = fitted
            self.get_logger().info(
                f"{axis}: "
                + ", ".join(f"{k}={v:.3f}" for k, v in fit.items())
                + f" (R^2 {r2:.2f}, rms {rms:.2f})"
            )
        self.report(hold, results)

    def report(self, hold: np.ndarray, results: dict):
        def value(axis, key, default=0.0):
            return results[axis][0].get(key, default) if axis in results else default

        mass = [value(a, "inertia", float("nan")) for a in ("x", "y", "z")]
        inertia = [value(a, "inertia", float("nan")) for a in ("roll", "pitch", "yaw")]
        linear = [value(a, "linear_drag") for a in AXES]
        quadratic = [value(a, "quadratic_drag") for a in AXES]
        # z: tau = m dw/dt + drag - net_buoyancy, so the bias is minus the net
        # buoyancy; without a z test, holding depth needed minus it too.
        net = -value("z", "bias") if "z" in results else -hold[2]
        buoyancy = self.get_parameter("buoyancy").value
        righting = [value(a, "righting") for a in ("roll", "pitch") if a in results]
        lines = [
            "    model:",
            f"      mass: [{', '.join(f'{m:.1f}' for m in mass)}]",
            f"      inertia: [{', '.join(f'{j:.2f}' for j in inertia)}]",
            f"      net_buoyancy: {net:.1f}",
            f"      linear_drag: [{', '.join(f'{d:.2f}' for d in linear)}]",
            f"      quadratic_drag: [{', '.join(f'{d:.2f}' for d in quadratic)}]",
        ]
        if righting:
            # roll: k_c = -B r_y; pitch: k_c = B r_x; both: k_s = B r_z (r = CB - CG).
            moment = [value("pitch", "trim"), -value("roll", "trim"), float(np.mean(righting))]
            if buoyancy > 0:
                lines.append(f"      buoyancy: {buoyancy:.1f}")
                lines.append(
                    "      # center_of_buoyancy: center_of_gravity + "
                    f"[{moment[0] / buoyancy:.4f}, {moment[1] / buoyancy:.4f}, {moment[2] / buoyancy:.4f}]"
                )
            lines.append(
                f"      # buoyancy x (CB - CG) [N m]: [{moment[0]:.2f}, {moment[1]:.2f}, {moment[2]:.2f}]"
            )
        print(
            "\nIdentified model; paste into the gains file and check the fits above:\n"
            + "\n".join(lines)
        )


def main():
    # rclpy's own SIGINT handler would shut the context down before the
    # `finally` below could send the hold that ends an open-loop step.
    rclpy.init(args=sys.argv, signal_handler_options=SignalHandlerOptions.NO)
    node = Identifier()
    executor = MultiThreadedExecutor()
    executor.add_node(node)
    spinner = threading.Thread(target=executor.spin, daemon=True)
    spinner.start()
    try:
        node.run()
    except KeyboardInterrupt:
        pass
    finally:
        node.hold(node.get_parameter("depth").value)
        rclpy.shutdown()
        spinner.join()


if __name__ == "__main__":
    main()
