<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sub_vision</name>
  <version>0.0.0</version>
  <description>YOLOv10 perception pipeline for the Marlin V2 AUV: ONNX Runtime /
    TensorRT inference, per-task OpenCV post-processing, and depth-based 3D
    metadata.</description>
  <maintainer email="avbotzco@gmail.com">AVBotz</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sub_vision_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
