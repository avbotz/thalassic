<?xml version="1.0"?>
<scenario>
  <environment>
    <ned latitude="33.701722" longitude="-117.780354"/>

    <ocean>
			<water density="1025.0" jerlov="0.25"/>
			<waves height="0.0"/>
      <particles enabled="false"/>
			<current type="uniform">
				<velocity xyz="0.0 0.0 0.0"/>
			</current>
		</ocean>

		<atmosphere>
			<sun azimuth="120.0" elevation="50.0"/>
		</atmosphere>
  </environment>

  <materials>
    <material name="Plastic" density="1200.0" restitution="0.2"/>
    <material name="Rock" density="0.000001" restitution="0.8"/>
    <material name="PVC" density="1400.0" restitution="0.2"/>
  </materials>

  <looks>
    <look name="Gray" gray="0.5" roughness="0.7"/>
    <look name="Yellow" rgb="1.0 0.9 0.0" roughness="0.3"/>


    <look name="Pool" gray="1.0" roughness="1.0" texture="models/pools/woollett/white_texture.jpg"/>
  </looks>

  <static name="woollett" type="model">
    <physical>
      <mesh filename="models/pools/woollett/woollett_collision.obj" scale="1.0" convex="true"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </physical>
    <visual>
      <mesh filename="models/pools/woollett/woollett.obj" scale="1.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </visual>
    <material name="Rock"/>
    <look name="Pool"/>
    <world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </static>


  <!-- Gate Task -->

  <static name="gate" type="model">
    <physical>
      <mesh filename="models/gate_task/gate/gate.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <world_transform xyz="9.984822249450819 -1.7909768919993514 0.2" rpy="0.0 0.0 4.424115854812463"/>
  </static>

  <static name="path_1" type="model">
    <physical>
      <mesh filename="models/path/path.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <world_transform xyz="10.404716510906075 -3.439489439196303 2.1" rpy="0.0 0.0 -0.5466737594090874"/>
  </static>


  <!-- Slalom Task -->

  <static name="slalom_1" type="model">
    <physical>
      <mesh filename="models/slalom_task/slalom/slalom_collision.obj" scale="1.0" convex="true"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <visual>
      <mesh filename="models/slalom_task/slalom/slalom.obj" scale="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <material name="PVC"/>
    <look name="Gray"/>
    <world_transform xyz="0 -8.048412019143367 1.1" rpy="0.0 0.0 -0.11525267308196652"/>
  </static>

  <static name="slalom_2" type="model">
    <physical>
      <mesh filename="models/slalom_task/slalom/slalom_collision.obj" scale="1.0" convex="true"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <visual>
      <mesh filename="models/slalom_task/slalom/slalom.obj" scale="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <material name="PVC"/>
    <look name="Gray"/>
    <world_transform xyz="20.817598702446087 -8.048412019143367 1.1" rpy="0.0 0.0 -0.11525267308196652"/>
  </static>

  <static name="slalom_3" type="model">
    <physical>
      <mesh filename="models/slalom_task/slalom/slalom_collision.obj" scale="1.0" convex="true"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <visual>
      <mesh filename="models/slalom_task/slalom/slalom.obj" scale="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <material name="PVC"/>
    <look name="Gray"/>
    <world_transform xyz="20.817598702446087 -5.048412019143367 1.1" rpy="0.0 0.0 -0.11525267308196652"/>
  </static>

  <static name="path_2" type="model">
    <physical>
      <mesh filename="models/path/path.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <world_transform xyz="21.492808691619647 -8.048412019143367 2.1" rpy="0.0 0.0 -0.5614306910315663"/>
  </static>


  <!-- Bin Task -->

  <static name="bin" type="model">
    <physical>
      <mesh filename="models/bin_task/bin/bin.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <world_transform xyz="27.84939713085642 -10.575098922383658 2.0" rpy="1.5707963267948966 0.0 -1.8563510316526357"/>
  </static>


  <!-- Torpedoes Task -->
  <static name="torpboard_shark" type="model">
    <physical>
      <mesh filename="models/torpedoes_task/torpboard_shark/torpboard_shark_collision.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <visual>
      <mesh filename="models/torpedoes_task/torpboard_shark/torpboard_shark.obj" scale="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <material name="Plastic"/>
    <look name="Gray"/>
    <world_transform xyz="0 -5.0 2.0" rpy="0.0 0.0 0.0"/>
  </static>


  <!-- Octagon Task -->
  <static name="octagon" type="model">
    <physical>
      <mesh filename="models/octagon_task/octagon/octagon.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <world_transform xyz="3 -5 0.0" rpy="0.0 0.0 0.0"/>
  </static>

  <static name="table" type="model">
    <physical>
      <mesh filename="models/octagon_task/table/table_collision.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <visual>
      <mesh filename="models/octagon_task/table/table.obj" scale="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <material name="Plastic"/>
    <look name="Gray"/>
    <world_transform xyz="3 -5 1.9" rpy="0.0 0.0 0"/>
  </static>

  <dynamic name="bottle_red" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/bottle_red/bottle_red.obj" scale="1.0" convex="true"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <mass value="30.0"/>
    <world_transform xyz="2.5 -5 0.7" rpy="0.0 0.0 0.0"/>
  </dynamic>

  <dynamic name="bottle_yellow" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/bottle_yellow/bottle_yellow.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <mass value="300.0"/>
    <world_transform xyz="3.5 -5 0" rpy="0.0 0.0 2.605499573307266"/>
  </dynamic>

  <static name="ladle_red" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/ladle_red/ladle_red.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <mass value="300.0"/>
    <world_transform xyz="3 -5.5 0" rpy="0.0 0.0 0.0"/>
  </static>

  <static name="ladle_yellow" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/ladle_yellow/ladle_yellow.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <material name="Plastic"/>
    <look name="Gray"/>
    <mass value="3000.0"/>
    <world_transform xyz="3 -4.5 0" rpy="0.0 0.0 0.0"/>
  </static>

