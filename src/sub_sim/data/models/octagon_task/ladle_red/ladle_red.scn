<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="Ladle_Red" rgb="1.0 0 0" roughness="0.3"/>  <!-- 255, 0, 0 -->
  </looks>

  <dynamic name="ladle_red" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/ladle_red/ladle_red.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>

    <material name="Plastic"/>
    <look name="Ladle_Red"/>

    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </dynamic>
</scenario>