<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="Torpboard_Sawfish_Board" gray="1.0" roughness="0.1" texture="models/torpedoes_task/torpboard_sawfish/torp_sawfish.png" />
    <look name="Torpboard_Sawfish_PVC" gray="1.0" roughness="0.1" texture="models/torpedoes_task/torpboard_sawfish/white.png" />
  </looks>

  <static name="torpboard_sawfish_pvc" type="model">
    <physical>
      <mesh filename="models/torpedoes_task/torpboard_sawfish/pvc/pvc_collision.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <visual>
      <mesh filename="models/torpedoes_task/torpboard_sawfish/pvc/pvc.obj" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>

    <material name="Plastic" />
    <look name="Torpboard_Sawfish_PVC" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>

  <static name="torpboard_sawfish_board" type="model">
    <physical>
      <mesh filename="models/torpedoes_task/torpboard_sawfish/torpboard_sawfish_collision.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <visual>
      <mesh filename="models/torpedoes_task/torpboard_sawfish/torpboard_sawfish.obj" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>

    <material name="Plastic" />
    <look name="Torpboard_Sawfish_Board" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>
</scenario>