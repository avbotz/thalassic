<?xml version="1.0"?>
<!-- Change language type to XML in VSCode for syntax highlighting -->
<scenario>
  <environment>
    <ned latitude="33.701722" longitude="-117.780354" />

    <ocean>
      <water density="1025.0" jerlov="0.20" />
      <waves height="0" />
      <particles enabled="false" />
      <current type="uniform">
        <velocity xyz="0 0 0" />
      </current>
    </ocean>

    <atmosphere>
      <sun azimuth="120" elevation="50" />
    </atmosphere>
  </environment>

  <!-- densities in kg/m^3  -->
  <materials>
    <material name="Air" density="1.2" restitution="0.0"/>
    <material name="Aluminum" density="1500.0" restitution="0.7"/>
    <material name="Acrylic" density="1000.0" restitution="0.5"/>
    <material name="Plastic" density="800.0" restitution="0.2" />
    <material name="Concrete" density="2400" restitution="0.8" />
    <material name="PVC" density="1450" restitution="0.2" />
  </materials>

  <!-- render_robot() renders the robot scenario template with this pose via
       Jinja and returns the rendered file's path. Use fuzz()/fuzz_z() to
       randomize, e.g. y=fuzz(-10.35, DY), yaw=fuzz(PI, DYAW). -->
  <include file="{{ render_robot(
      x=17.25,
      y=-10.35,
      z=0.5,
      roll=0.0,
      pitch=0.0,
      yaw=PI
  ) }}" />

  <include file="models/pools/woollett/woollett.scn">
    <arg name="x" value="0" />
    <arg name="y" value="0" />
    <arg name="z" value="0" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="0" />
  </include>


  <!-- Gate Task -->

  <include file="models/gate_task/gate/gate.scn">
    <arg name="x" value="{{ fuzz(17.25, DX) }}" />
    <arg name="y" value="{{ fuzz(-7, DY) }}" />
    <arg name="z" value="{{ fuzz_z(0.2, DZ) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(PI/2, DYAW) }}" />
  </include>

  <include file="models/path/path.scn">
    <arg name="x" value="{{ fuzz(17.5, 0.05) }}" />
    <arg name="y" value="{{ fuzz(-5.8, 0.05) }}" />
    <arg name="z" value="{{ fuzz_z(2.1, 0.10) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ 0.84 }}" />
  </include>


  <!-- Slalom Task -->

  <include file="models/slalom_task/slalom/slalom.scn">
    <arg name="x" value="{{ fuzz(18 + 0.65, 0.05) }}" />
    <arg name="y" value="{{ fuzz(-3.85 + 1*2, 0.05) }}" />
    <arg name="z" value="{{ rand(1.05, 1.35) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(PI/2, DYAW/3) }}" />
  </include>

  <include file="models/slalom_task/slalom/slalom.scn">
    <arg name="x" value="{{ fuzz(18 + 1.95, 0.05) }}" />
    <arg name="y" value="{{ fuzz(-3.85 + 1*1, 0.05) }}" />
    <arg name="z" value="{{ rand(1.05, 1.35) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(PI/2, DYAW/3) }}" />
  </include>

  <include file="models/slalom_task/slalom/slalom.scn">
    <arg name="x" value="{{ fuzz(18 + 0.95, 0.05) }}" />
    <arg name="y" value="{{ fuzz(-3.85 + 1*0, 0.05) }}" />
    <arg name="z" value="{{ rand(1.05, 1.35) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(PI/2, DYAW/3) }}" />
  </include>

  <include file="models/path/path.scn">
    <arg name="x" value="{{ fuzz(17.5, 0.05) }}" />
    <arg name="y" value="{{ fuzz(-0.6, 0.05) }}" />
    <arg name="z" value="{{ fuzz_z(2.1, 0.10) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(-PI / 6, DYAW / 2) }}" />
  </include>


  <!-- Bin Task -->

  <include file="models/bin_task/bin/bin.scn">
    <arg name="x" value="{{ fuzz(15.4, DX) }}" />
    <arg name="y" value="{{ fuzz(1.1, DY) }}" />
    <arg name="z" value="{{ fuzz_z(2.1, DZ) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(-0.25, DYAW) }}" />
  </include>

  <include file="models/torpedoes_task/{{ ['torpboard_v1/torpboard_v1.scn', 'torpboard_v2/torpboard_v2.scn'] | random }}">
    <arg name="x" value="{{ fuzz(16.3, DX) }}" />
    <arg name="y" value="{{ fuzz(5.0,  DY) }}" />
    <arg name="z" value="{{ fuzz_z(2.0, DZ) }}" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(1.2, DYAW) }}" />
  </include>


  <!-- Octagon Task -->

  <include file="models/octagon_task/octagon/octagon.scn">
    <arg name="x" value="{{ fuzz(21.6, 0.05) }}" />
    <arg name="y" value="{{ fuzz(8, 0.05) }}" />
    <arg name="z" value="0" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(0, DYAW / 5) }}" />
  </include>

  <include file="models/octagon_task/table/table.scn">
    <arg name="x" value="{{ fuzz(21.6, 0.05) }}" />
    <arg name="y" value="{{ fuzz(8, 0.05) }}" />
    <arg name="z" value="2.1" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(0, DYAW / 5) }}" />
  </include>

  <include file="models/octagon_task/bottle_red/bottle_red.scn">
    <arg name="x" value="{{ fuzz(21.3, 0.05) }}" />
    <arg name="y" value="{{ fuzz(8, 0.05) }}" />
    <arg name="z" value="0.7" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(0, DYAW) }}" />
  </include>

  <include file="models/octagon_task/bottle_yellow/bottle_yellow.scn">
    <arg name="x" value="{{ fuzz(21.7, 0.05) }}" />
    <arg name="y" value="{{ fuzz(8, 0.05) }}" />
    <arg name="z" value="0.7" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(0, DYAW) }}" />
  </include>

  <include file="models/octagon_task/ladle_red/ladle_red.scn">
    <arg name="x" value="{{ fuzz(21.6, 0.05) }}" />
    <arg name="y" value="{{ fuzz(8.1, 0.05) }}" />
    <arg name="z" value="0.7" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(0, DYAW) }}" />
  </include>

  <include file="models/octagon_task/ladle_yellow/ladle_yellow.scn">
    <arg name="x" value="{{ fuzz(21.7, 0.05) }}" />
    <arg name="y" value="{{ fuzz(7.9, 0.05) }}" />
    <arg name="z" value="0.7" />
    <arg name="roll" value="0" />
    <arg name="pitch" value="0" />
    <arg name="yaw" value="{{ fuzz(0, DYAW) }}" />
  </include>
</scenario>
