<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="gate" gray="1.0" roughness="0.1" texture="models/gate_task/gate/gate.png" />
  </looks>

  <static name="gate" type="model">
    <physical>
      <mesh filename="models/gate_task/gate/gate_collision.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <!-- $(arg visual) is gate.obj, with the Survey & Repair image left of the way
         through (+x) and Search & Rescue right, or gate_swapped.obj -->
    <visual>
      <mesh filename="models/gate_task/gate/$(arg visual)" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>

    <material name="pvc" />
    <look name="gate" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>
</scenario>
