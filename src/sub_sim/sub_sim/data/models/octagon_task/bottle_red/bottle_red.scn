<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="bottle_red" rgb="1.0 0 0" roughness="0.3"/>  <!-- 255, 0, 0 -->
  </looks>

  <dynamic name="bottle_red" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/bottle_red/bottle_red_collision.obj" scale="1.0" convex="true"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <visual>
      <mesh filename="models/octagon_task/bottle_red/bottle_red.obj" scale="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <material name="plastic"/>
    <look name="bottle_red"/>

    <!-- Where the object is, for sim_grabber: the middle of its collision hull -->
    <sensor name="odometry" rate="10.0" type="odometry">
      <origin xyz="0.0 -0.002 -0.033" rpy="0 0 0"/>
      <ros_publisher topic="/sim/objects/bottle_red/odometry"/>
    </sensor>

    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </dynamic>
</scenario>