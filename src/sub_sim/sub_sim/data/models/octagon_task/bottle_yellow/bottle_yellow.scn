<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="Bottle_Yellow" rgb="1.0 0.8588 0" roughness="0.3"/>  <!-- 255, 219, 0 -->
  </looks>

  <dynamic name="bottle_yellow" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/bottle_yellow/bottle_yellow_collision.obj" scale="1.0" convex="true"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>
    <visual>
      <mesh filename="models/octagon_task/bottle_yellow/bottle_yellow.obj" scale="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <material name="Plastic"/>
    <look name="Bottle_Yellow"/>

    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </dynamic>
</scenario>