<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="table" gray="1.0" roughness="0.7" texture="models/octagon_task/table/table.png" />
  </looks>

  <static name="table" type="model">
    <physical>
      <mesh filename="models/octagon_task/table/table_collision.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <visual>
      <mesh filename="models/octagon_task/table/table.obj" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>

    <material name="plastic" />
    <look name="table" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>
</scenario>
