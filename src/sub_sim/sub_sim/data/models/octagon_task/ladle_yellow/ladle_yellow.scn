<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="ladle_yellow" rgb="1.0 0.8588 0" roughness="0.3"/>  <!-- 255, 219, 0 -->
  </looks>

  <dynamic name="ladle_yellow" type="model" physics="submerged" buoyant="false">
    <physical>
      <mesh filename="models/octagon_task/ladle_yellow/ladle_yellow.obj" scale="1.0" convex="false"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </physical>

    <material name="plastic"/>
    <look name="ladle_yellow"/>

    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </dynamic>
</scenario>