<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="torpboard_v1" gray="1.0" roughness="0.1" texture="models/torpedoes_task/torpboard_v1/torpboard_v1.png" />
  </looks>

  <static name="torpboard_v1" type="model">
    <physical>
      <mesh filename="models/torpedoes_task/torpboard_v1/torpboard_v1_collision.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <visual>
      <mesh filename="models/torpedoes_task/torpboard_v1/torpboard_v1.obj" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>

    <material name="plastic" />
    <look name="torpboard_v1" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>
</scenario>
