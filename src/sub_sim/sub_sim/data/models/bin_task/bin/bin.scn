<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="bin_black" gray="0.0" roughness="0.1" />
    <look name="bin_white" gray="1.0" roughness="0.1" />
    <look name="bin_images" gray="1.0" roughness="0.1" texture="models/bin_task/bin/bin.png" />
  </looks>

  <static name="bin_screws" type="model">
    <physical>
      <mesh filename="models/bin_task/bin/parts/screws.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>

    <material name="plastic" />
    <look name="bin_black" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>

  <static name="bin_black" type="model">
    <physical>
      <mesh filename="models/bin_task/bin/parts/black.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>

    <material name="plastic" />
    <look name="bin_black" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>

  <static name="bin_white" type="model">
    <physical>
      <mesh filename="models/bin_task/bin/parts/white.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>

    <material name="plastic" />
    <look name="bin_white" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>

  <static name="bin_image" type="model">
    <physical>
      <mesh filename="models/bin_task/bin/parts/image.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>

    <material name="plastic" />
    <look name="bin_images" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>
</scenario>