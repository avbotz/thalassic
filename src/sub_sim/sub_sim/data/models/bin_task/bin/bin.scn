<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="bin" gray="1.0" roughness="0.1" texture="models/bin_task/bin/bin.png" />
  </looks>

  <static name="bin" type="model">
    <physical>
      <mesh filename="models/bin_task/bin/bin_collision.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <visual>
      <mesh filename="models/bin_task/bin/bin.obj" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>

    <material name="plastic" />
    <look name="bin" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>
</scenario>
