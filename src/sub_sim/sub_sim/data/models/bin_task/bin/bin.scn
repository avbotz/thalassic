<?xml version="1.0"?>
<scenario>
  <looks>
    <look name="bin_blood" gray="1.0" roughness="0.1" texture="models/bin_task/bin/Task3_Blood.png" />
    <look name="bin_fire" gray="1.0" roughness="0.1" texture="models/bin_task/bin/Task3_Fire.png" />
    <look name="bin_struct" rgb="0.53 0.55 0.59" roughness="0.1" />
  </looks>

  <static name="bin_struct" type="model">
    <physical>
      <mesh filename="models/bin_task/bin/bins_v2_struct.obj" scale="1.0" convex="false" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <material name="plastic" />
    <look name="bin_struct" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>

  <static name="bin_blood" type="model">
    <physical>
      <mesh filename="empty.obj" scale="1.0" convex="true" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <visual>
      <mesh filename="models/bin_task/bin/bins_v2_blood.obj" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>
    <material name="plastic" />
    <look name="bin_blood" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>

  <static name="bin_fire" type="model">
    <physical>
      <mesh filename="empty.obj" scale="1.0" convex="true" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </physical>
    <visual>
      <mesh filename="models/bin_task/bin/bins_v2_fire.obj" scale="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </visual>
    <material name="plastic" />
    <look name="bin_fire" />
    <world_transform xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
  </static>
</scenario>
