{% macro thruster_visual(
    name,
    xyz="0.0 0.0 0.0",
    rpy="0.0 0.0 0.0",
    material="Plastic",
    look_name="Black"
) -%}
  <external_part name="{{ name }}_visual" type="model" physics="submerged" buoyant="true">
    <physical>
      <mesh filename="robots/marlin_v2/thruster/thruster_collision.obj" scale="1.0" convex="true" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </physical>

    <visual>
      <mesh filename="robots/marlin_v2/thruster/thruster.obj" scale="1.0" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </visual>

    <mass value="0.239" />

    <material name="{{ material }}" />
    <look name="{{ look_name }}" />

    <compound_transform xyz="{{ xyz }}" rpy="{{ rpy }}" />
  </external_part>
{%- endmacro %}

{% macro thruster_actuator(
    name,
    link_name="base_link",
    xyz="0.0 0.0 0.0",
    rpy="0.0 0.0 0.0",
    right="true",
    material="Plastic",
    look_name="Black"
) -%}
  <actuator name="{{ name }}" type="thruster">
    <link name="{{ link_name }}" />

    <specs max_setpoint="400.0" inverted_setpoint="false" normalized_setpoint="false" />
    <propeller diameter="0.0765" right="{{ right }}">
      <mesh filename="robots/marlin_v2/thruster/propeller.obj" scale="1.0" />
      <material name="{{ material }}" />
      <look name="{{ look_name }}" />
    </propeller>

    <rotor_dynamics type="first_order">
      <time_constant value="0.08" />
    </rotor_dynamics>
    <thrust_model type="linear_interpolation">
