{% macro thruster_visual(
    name,
    xyz="0.0 0.0 0.0",
    rpy="0.0 0.0 0.0",
    material="plastic",
    look_name="black"
) -%}
  <external_part name="{{ name }}_visual" type="model" physics="submerged" buoyant="true">
    <physical>
      <mesh filename="robots/marlin_v3/thruster/thruster_collision.obj" scale="1.0" convex="true" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </physical>

    <visual>
      <mesh filename="robots/marlin_v3/thruster/thruster.obj" scale="1.0" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </visual>

    <mass value="0.239" />

    <material name="{{ material }}" />
    <look name="{{ look_name }}" />

    <compound_transform xyz="{{ xyz }}" rpy="{{ rpy }}" />
  </external_part>
{%- endmacro %}

