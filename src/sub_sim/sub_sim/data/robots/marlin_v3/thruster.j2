{% macro thruster_visual(
    name,
    xyz="0.0 0.0 0.0",
    rpy="0.0 0.0 0.0",
    material="plastic",
    look_name="black"
) -%}
  <external_part name="{{ name }}_visual" type="model" physics="submerged" buoyant="true">
    <physical>
      <mesh filename="robots/marlin_v3/thruster/thruster_collision.obj" scale="1.0" convex="true" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </physical>

    <visual>
      <mesh filename="robots/marlin_v3/thruster/thruster.obj" scale="1.0" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </visual>

    <mass value="0.239" />

    <material name="{{ material }}" />
    <look name="{{ look_name }}" />

    <compound_transform xyz="{{ xyz }}" rpy="{{ rpy }}" />
  </external_part>
{%- endmacro %}

{% macro thruster_actuator(
    name,
    thrust,
    battery_voltage,
    link_name="base_link",
    xyz="0.0 0.0 0.0",
    rpy="0.0 0.0 0.0",
    right="true",
    material="plastic",
    look_name="marlin_blue"
) -%}
  <actuator name="{{ name }}" type="thruster">
    <link name="{{ link_name }}" />

    <specs max_setpoint="1.0" inverted_setpoint="false" normalized_setpoint="false" />
    <propeller diameter="0.0765" right="{{ right }}">
      <mesh filename="robots/marlin_v3/thruster/propeller_{{ 'cw' if right == 'true' else 'ccw' }}.obj" scale="1.0" />
      <material name="{{ material }}" />
      <look name="{{ look_name }}" />
    </propeller>

    <!-- The ESC: the BlueRobotics Basic ESC takes ~0.1 s to respond. -->
    <rotor_dynamics type="first_order">
      <time_constant value="0.1" />
    </rotor_dynamics>
    <!-- The T200's measured thrust [N] against the normalised command (-1 to 1, which the
         rotor's "angular velocity" stands for) at each supply voltage: sub_control's own
         curve (its data/t200_thrust.csv, through thrust_curve()). The ESCs are open loop,
         so the thrust follows the battery voltage. -->
    <thrust_model type="linear_interpolation" supply_voltage="{{ battery_voltage }}">
      <input value="{{ thrust.commands }}" />
      <output voltage="{{ thrust.voltages }}" value="{{ thrust.forces }}" />
    </thrust_model>

    <origin xyz="{{ xyz }}" rpy="{{ rpy }}" />
  </actuator>
{%- endmacro %}
