<?xml version="1.0"?>
<scenario>
  {% from "thruster.j2" import thruster_actuator, thruster_visual %}
  {% from "torpedo.j2" import torpedo_robot with context %}

  <looks>
    <look name="white" gray="0.9" roughness="0.5" />
    <look name="gray" gray="0.5" roughness="0.5" />
    <look name="black" gray="0.05" roughness="0.5" />
    <look name="marlin_blue" rgb="{{ 59 / 255 }} {{ 96 / 255 }} {{ 180 / 255 }}" roughness="0.5" />
    <look name="ball_red" rgb="0.95 0.1 0.1" roughness="0.4" />
  </looks>

  <solver>
    <global_damping value="0.35"/>
    <!-- The fluid forces of the scene's few small bodies are quicker to compute
         on the physics thread than to hand out to worker threads every step -->
    <multithreading max_physics_threads="1" />
    <!-- Lets free bodies (the octagon's bottles and ladles) sleep once they have
         settled; resting in contact they otherwise take half the physics time.
         Touching one wakes it. Robots' links never sleep. Stonefish applies all
         of these settings together, so they live in this one solver block. -->
    <sleeping_thresholds linear="0.05" angular="0.1" />
  </solver>

  <robot name="marlin_v3" fixed="false" self_collisions="true" algorithm="featherstone">
    <base_link name="base_link_ned" type="compound" physics="submerged">

      <!-- Frame -->

      <external_part name="frame_top" type="model" physics="submerged" buoyant="true">
        <physical>
          <mesh filename="robots/marlin_v3/frame/frame_top/frame_top_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/frame/frame_top/frame_top.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="3.460" />

        <material name="aluminum" />
        <look name="black" />

        <compound_transform xyz="0.0 0.0 -0.025" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="frame_front" type="model" physics="submerged" buoyant="true">
        <physical>
          <mesh filename="robots/marlin_v3/frame/frame_front/frame_front_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/frame/frame_front/frame_front.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="0.274" />

        <material name="aluminum" />
        <look name="black" />

        <compound_transform xyz="0.0 -0.314 0.08462" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="frame_back" type="model" physics="submerged" buoyant="true">
        <physical>
          <mesh filename="robots/marlin_v3/frame/frame_back/frame_back_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/frame/frame_back/frame_back.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="0.274" />

        <material name="aluminum" />
        <look name="black" />

        <compound_transform xyz="0.0 0.309 0.08462" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="frame_left" type="model" physics="submerged" buoyant="true">
        <physical>
          <mesh filename="robots/marlin_v3/frame/frame_left/frame_left_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/frame/frame_left/frame_left.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="0.481" />

        <material name="aluminum" />
        <look name="black" />

        <compound_transform xyz="0.3304 0.016419 0.083065" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="frame_right" type="model" physics="submerged" buoyant="true">
        <physical>
          <mesh filename="robots/marlin_v3/frame/frame_right/frame_right_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/frame/frame_right/frame_right.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="0.481" />

        <material name="aluminum" />
        <look name="black" />

        <compound_transform xyz="-0.3304 0.016419 0.083065" rpy="0.0 0.0 0.0" />
      </external_part>


      <!-- Meb -->

      <external_part name="meb" type="cylinder" physics="surface">
        <dimensions radius="0.117" height="0.66" thickness="0.003" />
        <origin xyz="0.0 0.0 0.0" rpy="{{ PI / 2 }} 0.0 0.0"/>

        <material name="acrylic"/>
        <look name="white"/>

        <hydrodynamics viscous_drag="5.0 5.0 5.0" quadratic_drag="1.2 1.2 1.2"/> 

        <compound_transform xyz="0.0 0.0 -0.227" rpy="0.0 0.0 0.0" />
      </external_part>

      <!-- TODO: Add transparency to Stonefish -->
      <!-- <external_part name="meb_front_camera_dome" type="model" physics="surface">
        <physical>
          <mesh filename="robots/marlin_v3/meb_front_camera_dome/meb_front_camera_dome_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="empty.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <material name="acrylic" />
        <look name="white" />

        <compound_transform xyz="0.0 -0.348744 -0.166305" rpy="0.0 0.0 0.0" />
      </external_part> -->

      <external_part name="meb_mounting_front" type="model" physics="submerged" buoyant="true">
        <physical>
          <mesh filename="robots/marlin_v3/meb_mounting_front/meb_mounting_front_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/meb_mounting_front/meb_mounting_front.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <material name="plastic" />
        <look name="marlin_blue" />

        <compound_transform xyz="0.0 -0.32 -0.2" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="meb_mounting_rear" type="model" physics="submerged" buoyant="true">
        <physical>
          <mesh filename="robots/marlin_v3/meb_mounting_rear/meb_mounting_rear_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/meb_mounting_rear/meb_mounting_rear.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <material name="plastic" />
        <look name="marlin_blue" />

        <compound_transform xyz="0.0 0.32 -0.2" rpy="0.0 0.0 0.0" />
      </external_part>


      <!-- ESC Boxes -->

      <external_part name="esc_box_left" type="box" physics="submerged" buoyant="true">
        <dimensions xyz="0.15 0.22 0.04" thickness="0.01" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

        <material name="aluminum"/>
        <look name="white"/>

        <compound_transform xyz="-0.237215 0.0 -0.0475" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="esc_box_right" type="box" physics="submerged" buoyant="true">
        <dimensions xyz="0.15 0.22 0.04" thickness="0.01" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

        <material name="aluminum"/>
        <look name="white"/>

        <compound_transform xyz="0.237215 0.0 -0.0475" rpy="0.0 0.0 0.0" />
      </external_part>


      <!-- Task Based Component Mounting -->

      <external_part name="grabber_mounting" type="model" physics="surface">
        <physical>
          <mesh filename="robots/marlin_v3/grabber_mounting/grabber_mounting_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/grabber_mounting/grabber_mounting.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="0.001" />

        <material name="plastic" />
        <look name="marlin_blue" />

        <compound_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="dropper_mounting" type="model" physics="surface">
        <physical>
          <mesh filename="robots/marlin_v3/dropper_mounting/dropper_mounting_collision_bracket.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/dropper_mounting/dropper_mounting.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="0.001" />

        <material name="plastic" />
        <look name="marlin_blue" />

        <compound_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </external_part>

      <external_part name="torpedo_mounting" type="model" physics="surface">
        <physical>
          <mesh filename="robots/marlin_v3/torpedo_mounting/torpedo_mounting_collision.obj" scale="1.0" convex="true" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </physical>

        <visual>
          <mesh filename="robots/marlin_v3/torpedo_mounting/torpedo_mounting.obj" scale="1.0" />
          <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </visual>

        <mass value="0.001" />

        <material name="plastic" />
        <look name="marlin_blue" />

        <compound_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </external_part>


      <!-- Thrusters, excluding propeller which is added below. Placed from
           config/vehicles/<robot>.yaml (sub_bringup/vehicle.py), like the
           actuators further down. -->
      {% for thruster in thrusters %}
      {{ thruster_visual(name="thruster_" ~ loop.index0, xyz=thruster.xyz, rpy=thruster.rpy) }}
      {% endfor %}


      <!-- internal_part so it doesn't affect drag, mainly for buoyancy -->

      <internal_part name="rack" type="cylinder" physics="submerged" buoyant="true">
        <dimensions radius="0.117" height="0.66" />
        <origin xyz="0.0 0.0 0.0" rpy="{{ PI / 2 }} 0.0 0.0"/>

        <mass value="10" />

        <material name="air"/>
        <look name="gray"/>

        <compound_transform xyz="0.0 0.0 -0.227" rpy="0.0 0.0 0.0" />
      </internal_part>

      <internal_part name="disk_weights_front_right" type="cylinder" physics="submerged" buoyant="false">
        <dimensions radius="0.07" height="0.023" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

        <mass value="3.5" />

        <material name="aluminum"/>
        <look name="black"/>

        <compound_transform xyz="0.345 -0.35 0.095" rpy="0.0 {{ PI / 2 }} 0.0" />
      </internal_part>

      <internal_part name="disk_weights_front_left" type="cylinder" physics="submerged" buoyant="false">
        <dimensions radius="0.07" height="0.023" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

        <mass value="3.5" />

        <material name="aluminum"/>
        <look name="black"/>

        <compound_transform xyz="-0.345 -0.35 0.095" rpy="0.0 {{ PI / 2 }} 0.0" />
      </internal_part>

      <internal_part name="disk_weights_back_right" type="cylinder" physics="submerged" buoyant="false">
        <dimensions radius="0.07" height="0.023" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

        <mass value="3.5" />

        <material name="aluminum"/>
        <look name="black"/>

        <compound_transform xyz="0.345 0.35 0.095" rpy="0.0 {{ PI / 2 }} 0.0" />
      </internal_part>

      <internal_part name="disk_weights_back_left" type="cylinder" physics="submerged" buoyant="false">
        <dimensions radius="0.07" height="0.023" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

        <mass value="3.5" />

        <material name="aluminum"/>
        <look name="black"/>

        <compound_transform xyz="-0.345 0.35 0.095" rpy="0.0 {{ PI / 2 }} 0.0" />
      </internal_part>

      <internal_part name="esc_box_left_internal" type="box" physics="submerged" buoyant="true">
        <dimensions xyz="0.13 0.2 0.03" />

        <mass value="0.85" />

        <material name="air"/>
        <look name="white"/>

        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <compound_transform xyz="-0.237215 0.0 0.0" rpy="0.0 0.0 0.0" />
      </internal_part>

      <internal_part name="esc_box_right_internal" type="box" physics="submerged" buoyant="true">
        <dimensions xyz="0.13 0.2 0.03" />

        <mass value="0.85" />

        <material name="air"/>
        <look name="white"/>

        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <compound_transform xyz="0.237215 0.0 0.0" rpy="0.0 0.0 0.0" />
      </internal_part>
    </base_link>


    <!-- Task Based Components, at the vehicle description's frames. The servos run
         at a hobby servo's speed: Stonefish turns a joint at max_velocity until it is
         within one step of the setpoint. -->

    {% set left = frames.left_grabber_link %}
    <link name="left_grabber_link" type="model" physics="surface">
      <physical>
        <mesh filename="robots/marlin_v3/grabber/left/left_collision.obj" scale="1.0" convex="false" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </physical>

      <visual>
        <mesh filename="robots/marlin_v3/grabber/left/left.obj" scale="1.0" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </visual>

      <material name="plastic" />
      <look name="white" />
    </link>

    <!-- sim_grabber closes the jaws with a positive angle on the left and a negative
         one on the right -->
    <joint name="left_grabber_joint" type="revolute">
      <parent name="base_link_ned" />
      <child name="left_grabber_link" />
      <origin xyz="{{ left.xyz | join(' ') }}" rpy="{{ left.rpy | join(' ') }}" />
      <axis xyz="0.0 1.0 0.0" />
    </joint>

    <actuator name="left_grabber_servo" type="servo">
      <controller position_gain="1.0" velocity_gain="1.0" max_torque="10.0" max_velocity="4.0" />
      <joint name="left_grabber_joint" />
      <initial position="0.0" />
    </actuator>


    {% set right = frames.right_grabber_link %}
    <link name="right_grabber_link" type="model" physics="surface">
      <physical>
        <mesh filename="robots/marlin_v3/grabber/right/right_collision.obj" scale="1.0"
          convex="false" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </physical>

      <visual>
        <mesh filename="robots/marlin_v3/grabber/right/right.obj" scale="1.0" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </visual>

      <material name="plastic" />
      <look name="white" />
    </link>

    <joint name="right_grabber_joint" type="revolute">
      <parent name="base_link_ned" />
      <child name="right_grabber_link" />
      <origin xyz="{{ right.xyz | join(' ') }}" rpy="{{ right.rpy | join(' ') }}" />
      <axis xyz="0.0 1.0 0.0" />
    </joint>

    <actuator name="right_grabber_servo" type="servo">
      <controller position_gain="1.0" velocity_gain="1.0" max_torque="10.0" max_velocity="4.0" />
      <joint name="right_grabber_joint" />
      <initial position="0.0" />
    </actuator>


    {% set dropper = frames.dropper_link %}
    <link name="dropper_link" type="model" physics="surface">
      <physical>
        <mesh filename="robots/marlin_v3/dropper/dropper_collision.obj" scale="1.0" convex="true" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </physical>

      <visual>
        <mesh filename="robots/marlin_v3/dropper/dropper.obj" scale="1.0" />
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      </visual>

      <material name="plastic"/>
      <look name="white"/>
    </link>

    <joint name="dropper_joint" type="revolute">
      <parent name="base_link_ned"/>
      <child name="dropper_link"/>
      <origin xyz="{{ dropper.xyz | join(' ') }}" rpy="{{ dropper.rpy | join(' ') }}"/>
      <axis xyz="0.0 0.0 1.0"/>
    </joint>

    <actuator name="dropper_servo" type="servo">
      <controller position_gain="1.0" velocity_gain="1.0" max_torque="10.0" max_velocity="6.0"/>
      <joint name="dropper_joint"/>
      <initial position="0.0"/>
    </actuator>


    <!-- Sensors, mounted where the vehicle description puts them (frames) -->

    <sensor name="dvl_link" rate="10.0" type="dvl">
      <link name="base_link_ned" />

      <!-- The beams look down dvl_link's +z (the frame is FRD, as the A50's) -->
      <specs beam_angle="30.0" beam_positive_z="true" />
      <range velocity="3.75 3.75 3.75" altitude_min="0.00" altitude_max="50.0" />
      <water_layer minimum_layer_thickness="10.0" boundary_near="10.0" boundary_far="30.0" />
      {% if sensor_noise %}
      <!-- A50: a few mm/s of noise in a pool, plus 1% of speed -->
      <noise velocity_percent="1.0" velocity="0.005" altitude="0.01" water_velocity_percent="0.0" water_velocity="0.00" />
      {% else %}
      <noise velocity_percent="0.00" velocity="0.00" altitude="0.00" water_velocity_percent="0.0" water_velocity="0.00" />
      {% endif %}
      <history samples="1" />

      <origin xyz="{{ frames.dvl_link.xyz | join(' ') }}" rpy="{{ frames.dvl_link.rpy | join(' ') }}" />

      <ros_publisher topic="/marlin_v3/sim/dvl" />
    </sensor>

    <sensor name="imu_link" rate="30.0" type="imu">
      <link name="base_link_ned"/>

      <range angular_velocity="100.0 100.0 50.0" linear_acceleration="30.0 30.0 30.0"/>
      {% if sensor_noise %}
      <!-- NaviGuider class: ~0.1 deg attitude noise, ~0.2 deg/s gyro noise and
           ~10 deg/hr yaw drift (it has no magnetometer to correct it) -->
      <noise angle="0.002 0.002 0.002" angular_velocity="0.003 0.003 0.003" yaw_drift="0.00005" linear_acceleration="0.02 0.02 0.02"/>
      {% else %}
      <noise angle="0.0 0.0 0.0" angular_velocity="0.0 0.0 0.0" yaw_drift="0.0" linear_acceleration="0.00 0.00 0.00"/>
      {% endif %}
      <history samples="1"/>

      <!-- In base_link_ned's axes, which sim_imu_remapper turns into imu_link's -->
      <origin xyz="{{ frames.imu_link.xyz | join(' ') }}" rpy="0.0 0.0 0.0"/>

      <ros_publisher topic="/marlin_v3/sim/imu"/>
    </sensor>

    <sensor name="pressure_link" rate="30.0" type="pressure">
      <link name="base_link_ned" />

      <range pressure="10000000.0" />
      <!-- Bar30: ~3 mm of water -->
      <noise pressure="{{ 30.0 if sensor_noise else 0.0 }}" />
      <origin xyz="{{ frames.pressure_link.xyz | join(' ') }}" rpy="{{ frames.pressure_link.rpy | join(' ') }}" />

      <ros_publisher topic="/marlin_v3/sim/pressure" />
    </sensor>

    <!-- Ground truth: base_link_ned's pose and velocity in world_ned. Only the
         simulation's own nodes (sim_grabber) may read it; the stack estimates its
         pose like on the vehicle. -->
    <sensor name="ground_truth" rate="50.0" type="odometry">
      <link name="base_link_ned" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <ros_publisher topic="/marlin_v3/sim/odometry" />
    </sensor>

    <!-- Cameras look along their frame's z with y down, like a ROS optical
         frame, which is how the description's camera frames are set up -->
    {% set front = frames.front_camera %}
    <!-- Logitech C922: 1920x1080 at 24 Hz -->
    <sensor name="front_camera" rate="24.0" type="camera">
      <link name="base_link_ned" />

      <specs resolution_x="1920" resolution_y="1080" horizontal_fov="70.4" />
      <origin xyz="{{ front.xyz | join(' ') }}" rpy="{{ front.rpy | join(' ') }}" />
      <ros_publisher topic="/marlin_v3/front_camera" />
    </sensor>

    {% set down = frames.down_camera %}
    <!-- FLIR Blackfly S: 1280x1024 at 5 Hz -->
    <sensor name="down_camera" rate="5.0" type="camera">
      <link name="base_link_ned" />

      <specs resolution_x="1280" resolution_y="1024" horizontal_fov="69.0" />
      <origin xyz="{{ down.xyz | join(' ') }}" rpy="{{ down.rpy | join(' ') }}" />
      <ros_publisher topic="/marlin_v3/down_camera" />
    </sensor>

    {% if depth_camera %}
    <!-- At the front camera, as on a stereo or RGB-D camera -->
    <sensor name="depth_camera" rate="24.0" type="depth_camera">
      <link name="base_link_ned" />

      <specs resolution_x="1920" resolution_y="1080" horizontal_fov="70.4" depth_min="0.2" depth_max="20.0" />
      <noise depth="0.0" />
      <origin xyz="{{ front.xyz | join(' ') }}" rpy="{{ front.rpy | join(' ') }}" />

      <ros_publisher topic="/marlin_v3/sim/depth_camera" />
    </sensor>
    {% endif %}

    {% if segmentation_camera %}
    <!-- Labels the front camera's images for sim_labeling: paired with it, it is
         rendered in the same frames, from its viewpoint, so it needs its
         resolution (its origin and field of view are then not used). -->
    <sensor name="seg_cam" rate="10.0" type="segmentation">
      <link name="base_link_ned" />

      <specs resolution_x="1920" resolution_y="1080" horizontal_fov="70.4" />
      <origin xyz="{{ front.xyz | join(' ') }}" rpy="{{ front.rpy | join(' ') }}" />
      <paired_camera name="front_camera" />

      <ros_publisher topic="/marlin_v3/sim/segment" />
    </sensor>
    {% endif %}

    <!-- Thruster propellers, from the vehicle description. sim_thrusters
         (sub_sim_sensors) feeds them sim/thruster_setpoints from sub_control's
         control/thruster_<i>, in this order. -->
    <!-- Cannot use include tag here because they can only be used at the top level -->
    {% for thruster in thrusters %}
    {{ thruster_actuator(
      name="thruster_" ~ loop.index0,
      link_name="base_link_ned",
      xyz=thruster.xyz,
      rpy=thruster.rpy,
      right=thruster.right
    ) }}
    {% endfor %}

    <ros_base_link_transform publish="false" />

    <ros_publisher servos="/marlin_v3/sim/joint_states" thrusters="/marlin_v3/sim/thruster_states" />
    <ros_subscriber servos="/marlin_v3/sim/joint_setpoints" thrusters="/marlin_v3/sim/thruster_setpoints" />

    <world_transform xyz="{{ x }} {{ y }} {{ z }}" rpy="{{ roll }} {{ pitch }} {{ yaw }}" />
  </robot>

  <!-- The torpedoes and the droppers' balls are free bodies, glued to the robot until
       released; world_pose() starts them where the vehicle description mounts them. -->
  {{ torpedo_robot(
    name="torpedo_0",
    mesh="robots/marlin_v3/torpedoes/torpedo_right_facing.obj",
    frame=frames.torpedo_0_link,
  ) }}

  {{ torpedo_robot(
    name="torpedo_1",
    mesh="robots/marlin_v3/torpedoes/torpedo_left_facing.obj",
    frame=frames.torpedo_1_link,
  ) }}

  <!-- The droppers' balls, by dropper_id, above the gate that sim_dropper turns from
       under them; it releases the ball of the dropper opened. Ball 1 is left of ball 0,
       where the open gate does not reach (the mounting's collision hull fills the tube
       above ball 0, and the frame is in front of it). -->
  {% for left in [0.0, 0.032] %}
  {% set name = "dropper_ball_" ~ loop.index0 %}
  <robot name="{{ name }}" fixed="false" self_collisions="false" algorithm="featherstone">
    <base_link name="base_link" type="sphere" physics="submerged" buoyant="true">
      <dimensions radius="0.0155" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />

      <mass value="0.039" />

      <material name="plastic" />
      <look name="ball_red" />
    </base_link>

    <sensor name="{{ name }}_odometry" rate="10.0" type="odometry">
      <link name="base_link" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <ros_publisher topic="/marlin_v3/sim/{{ name }}/odometry" />
    </sensor>

    {% set ball = world_pose(frames.dropper_link, offset=[-0.00226 - left, -0.04502, -0.04065]) %}
    <world_transform xyz="{{ ball.xyz | join(' ') }}" rpy="{{ ball.rpy | join(' ') }}" />
  </robot>

  <glue name="{{ name }}_glue" activated="true">
    <first_body name="{{ name }}/base_link" />
    <second_body name="marlin_v3/base_link_ned" />
    <ros_service topic="/marlin_v3/sim/{{ name }}/glue" />
  </glue>
  {% endfor %}
</scenario>
