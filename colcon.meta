{
    "names": {
        "stonefish_ros2": {
            "dependencies": [
                "stonefish_vendor"
            ],
            "cmake-args": [
                "-DBUILD_TESTING=OFF"
            ]
        },
        "libwaterlinked": {
            "cmake-args": [
                "-DCMAKE_CXX_FLAGS=-pthread",
                "-DBUILD_TESTING=OFF"
            ]
        },
        "spinnaker_camera_driver": {
            "cmake-args": [
                "-DCMAKE_CXX_FLAGS=-include cstdint",
                "-DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined",
                "-DBUILD_TESTING=OFF"
            ]
        },
        "spinnaker_synchronized_camera_driver": {
            "cmake-args": [
                "-DCMAKE_CXX_FLAGS=-include cstdint",
                "-DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined",
                "-DBUILD_TESTING=OFF"
            ]
        },
        "waterlinked_dvl_driver": {
            "cmake-args": [
                "-DBUILD_TESTING=OFF"
            ]
        },
        "flir_camera_description": {
            "cmake-args": [
                "-DBUILD_TESTING=OFF"
            ]
        },
        "flir_camera_msgs": {
            "cmake-args": [
                "-DBUILD_TESTING=OFF"
            ]
        }
    }
}
