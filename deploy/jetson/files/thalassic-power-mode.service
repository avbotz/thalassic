# Installed at /etc/systemd/system/thalassic-power-mode.service.
[Unit]
Description=Thalassic: Jetson power mode for the vehicle
Documentation=https://github.com/avbotz/thalassic/blob/main/deploy/jetson/README.md
After=nvpmodel.service
ConditionPathExists=/usr/sbin/nvpmodel

[Service]
Type=oneshot
RemainAfterExit=yes
# Mode 0 is MAXN (every core online, no power cap).
ExecStart=/usr/sbin/nvpmodel -m 0

[Install]
WantedBy=multi-user.target
